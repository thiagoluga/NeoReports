<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-target net8.0: no .NET 9 runtime is installed on the build machine, so net9
         test hosts cannot run locally. Production libraries still multi-target net8/net9. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NeoReports.Licensing\NeoReports.Licensing.csproj" />
    <!-- The Pro packages are referenced only so ProLicenseGateTests can prove each gated entry point
         actually throws without a license. This assembly deliberately has NO [ModuleInitializer]
         seeding the gate (unlike the three Pro suites), which is what lets it close the gate. -->
    <ProjectReference Include="..\..\src\Formats\NeoReports.Xlsx.Pro\NeoReports.Xlsx.Pro.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.Join.Pro\NeoReports.Sources.Join.Pro.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.QueryBuilder.Pro\NeoReports.QueryBuilder.Pro.csproj" />
    <!-- The license-issuing tool, so its key-handling security controls are covered (ADR D70, Q3a). -->
    <ProjectReference Include="..\..\tools\NeoReports.LicenseTool\NeoReports.LicenseTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
