@* Topbar — logo + horizontal nav + search/bell/avatar.
   Highlights the active item based on the current route. *@
@inject NavigationManager Nav
@implements IDisposable

<div class="topbar">
    <div class="left">
        <a class="brand" href="">
            <img src="_content/NeoReports.UI/assets/logo-mark.svg" width="26" height="26" alt="" />
            <b>NeoReports</b>
        </a>
        <button class="icon-btn nav-toggle" aria-label="Menu" aria-expanded="@_menuOpen" @onclick="ToggleMenu">
            <i class="ti ti-@(_menuOpen ? "x" : "menu-2")"></i>
        </button>
        <nav class="nav @(_menuOpen ? "open" : "")">
            @foreach (var item in Items)
            {
                <a class="nav-item @(IsActive(item.Match) ? "active" : "")" href="@item.Href">@item.Label</a>
            }
        </nav>
    </div>
    <div class="right">
        <button class="icon-btn" aria-label="Search"><i class="ti ti-search"></i></button>
        <button class="icon-btn" aria-label="Notifications"><i class="ti ti-bell"></i></button>
        <span class="avatar" style="background:#26215C">MS</span>
    </div>
</div>

@code {
    private sealed record NavItem(string Label, string Href, string Match);

    private readonly NavItem[] Items =
    {
        new("Dashboard", "",                 "__root"),
        new("Reports",   "reports",          "reports"),
        new("Builder",   "builder",          "builder"),
        new("Sources",   "sources",          "sources"),
        new("Jobs",      "jobs/7c4a01f3",     "jobs"),
    };

    private bool _menuOpen;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, EventArgs e)
    {
        // Close the mobile menu on navigation — the layout persists across pages, so the
        // toggle state would otherwise survive into the next screen.
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private bool IsActive(string match)
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        var q = rel.IndexOf('?');
        if (q >= 0) rel = rel[..q];
        // "pipeline" belongs under Reports
        if (match == "reports" && rel.StartsWith("pipeline", StringComparison.OrdinalIgnoreCase)) return true;
        if (match == "__root") return string.IsNullOrEmpty(rel);
        return rel.StartsWith(match, StringComparison.OrdinalIgnoreCase);
    }
}
