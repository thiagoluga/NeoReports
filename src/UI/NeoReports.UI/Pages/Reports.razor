@page "/reports"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

<div class="page">
    <div class="page-head">
        <div class="title">
            <h1>Reports</h1>
            <div class="sub">Templates registered by code or via the builder · @_reports.Count reports</div>
        </div>
        <Button Variant="primary" Icon="plus" OnClick="@(() => Nav.NavigateTo("builder"))">New report</Button>
    </div>

    @* Count strip — running/failed computed from GET /api/jobs when live. "Active schedules" and
       "paused" are dropped when live: v1 has no scheduler, and jobs never reach Paused. *@
    <div class="count-strip">
    @if (_isLive)
    {
        <span class="c"><span class="dot" style="background:var(--info-dot)"></span><b>@_runningNow</b> running now</span>
        <span class="c"><span class="dot" style="background:var(--danger-dot)"></span><b>@_failedCount</b> failed</span>
    }
    else
    {
        <span class="c"><span class="dot" style="background:var(--success-dot)"></span><b>32</b> active schedules</span>
        <span class="c"><span class="dot" style="background:var(--info-dot)"></span><b>9</b> running now</span>
        <span class="c"><span class="dot" style="background:var(--warn-dot)"></span><b>3</b> paused</span>
        <span class="c"><span class="dot" style="background:var(--danger-dot)"></span><b>1</b> failed</span>
    }
    </div>

    @* Filter bar — GET /api/reports (client-side filter here) *@
    <FilterBar @bind-Search="_search" Placeholder="Search by name, tag or source">
        @if (_statusFilter is not null)
        {
            <Pill Active="true" OnClick="@(() => _statusFilter = null)">status: @_statusFilter <i class="ti ti-x"></i></Pill>
        }
        <Pill Icon="tag">Tag</Pill>
        <Pill Icon="arrows-sort">Sort by</Pill>
    </FilterBar>

    @* Report cards *@
    @if (!Filtered.Any())
    {
        <Card>
            <EmptyState Icon="report-off" Title="No reports match your filters">
                <ChildContent>
                    Try clearing the search, or create a new report from the builder.
                </ChildContent>
                <Action><Button Variant="primary" Icon="plus" OnClick="@(() => Nav.NavigateTo("builder"))">New report</Button></Action>
            </EmptyState>
        </Card>
    }
    else
    {
        <div class="col" style="gap:10px">
            @foreach (var r in Filtered)
            {
                <ReportCard Report="r"
                            OnOpen="@(() => Nav.NavigateTo($"reports/{r.Slug}"))"
                            OnPrimary="@(() => RunOrNavigateAsync(r))" />
            }
        </div>
    }
</div>

@code {
    private string _search = "";
    private string? _statusFilter = "running";
    private IReadOnlyList<ReportSummary> _reports = SampleData.Reports;
    private bool _isLive;
    private int _runningNow;
    private int _failedCount;

    private IEnumerable<ReportSummary> Filtered =>
        _reports.Where(r =>
            string.IsNullOrWhiteSpace(_search)
            || r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || r.Source.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        // GET /api/reports — falls back to sample data if the engine API isn't reachable
        // (e.g. this UI mounted without a NeoReports.AspNetCore host alongside it).
        var live = await Api.TryGetReportsAsync();
        if (live is { Count: > 0 })
        {
            _reports = live.Select(ToReportSummary).ToArray();
            _statusFilter = null;
            _isLive = true;

            var jobs = await Api.TryListJobsAsync(limit: 200);
            if (jobs is not null)
            {
                _runningNow = jobs.Count(j => j.Status is "Running" or "Retrying");
                _failedCount = jobs.Count(j => j.Status == "Failed");
            }
        }
    }

    private async Task RunOrNavigateAsync(ReportSummary r)
    {
        if (!_isLive)
        {
            Nav.NavigateTo(r.Status == JobStatus.Failed ? "jobs/failed" : "jobs/7c4a01f3");
            return;
        }

        // POST /api/reports/{name}/run — async trigger; land on the new job's live page.
        var jobId = await Api.TryRunReportAsync(r.Name);
        Nav.NavigateTo(jobId is not null ? $"jobs/{jobId}" : "jobs/failed");
    }

    // The engine exposes only name/output-count/columns today; the rest of ReportCard's
    // fields (schedule, last run, tags, source/destination) are mock/future — shown as
    // honest placeholders rather than fabricated demo data.
    private static ReportSummary ToReportSummary(ApiReportSummary r) => new(
        Slug: Uri.EscapeDataString(r.Name),
        Name: r.Name,
        Description: $"{r.OutputCount} output(s) · {r.Columns.Count} column(s).",
        Tags: Array.Empty<string>(),
        Status: JobStatus.Never,
        Source: "—",
        Formats: Array.Empty<string>(),
        Destination: "—",
        ScheduleTitle: "Not scheduled",
        ScheduleSub: "trigger via API or the run button",
        LastTitle: "—",
        LastSub: "never run",
        CatKind: "gray",
        CatIcon: "report");
}
