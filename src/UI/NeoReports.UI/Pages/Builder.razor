@page "/builder"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject BuilderState Wizard
@inject INeoReportsApiClient Api

<div class="page">
    <WizardStepper Steps="Steps" Current="0" />

    <div class="page-head">
        <div class="title">
            <h1>Choose the data source</h1>
            <div class="sub">Pick a registered source or create an ad-hoc one · step 1 of 5</div>
        </div>
    </div>

    @if (!Wizard.EngineAvailable)
    {
        <Banner Variant="info" Icon="info-circle">
            <b>Demo mode</b>
            <span style="font-size:12px">No engine capabilities were found — you can still browse the wizard, but "Save" is disabled at the end.</span>
        </Banner>
    }
    else
    {
        <Card Title="Engine source type" Sub="What POST /api/reports actually reads from — the cards below are illustrative only">
            <ChildContent>
            <div class="field">
                <span class="label-sm">Type</span>
                <select class="input mono" style="width:100%;max-width:280px" @bind="Wizard.SourceType">
                    @foreach (var type in _engineSources)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            </ChildContent>
        </Card>
    }

    @* Quick source *@
    <div class="quick-card">
        <CatTile Kind="warn" Icon="bolt" />
        <div class="info">
            <div class="title"><i class="ti ti-bolt" style="color:var(--warn-fg);font-size:14px"></i> Quick source · ad-hoc SQL</div>
            <div class="desc">Paste a connection string and a query. Not registered — handy for a one-off run.</div>
        </div>
        <Button Variant="outline" Icon="plus">Create</Button>
    </div>

    <div class="row-between" style="margin-top:4px">
        <span class="label-sm">Registered sources</span>
        <span class="mono muted" style="font-size:11px">@Filtered.Count() of @SampleData.Sources.Count</span>
    </div>

    <FilterBar @bind-Search="_search" Placeholder="Search source by name or type">
        <Pill Icon="filter">Type</Pill>
        <Pill Icon="clock">Recent</Pill>
    </FilterBar>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        @foreach (var s in Filtered)
        {
            <div class="sel-card @(_selected == s.Id ? "selected" : "")" @onclick="@(() => _selected = s.Id)">
                <div class="check"><i class="ti ti-check"></i></div>
                <CatTile Kind="@s.CatKind" Icon="@s.CatIcon" />
                <div class="name">@s.Name <span class="type-pill">@s.Type</span></div>
                <div class="conn">@s.Connection</div>
                <div class="meta">
                    <span style="display:inline-flex;align-items:center;gap:5px">
                        <span style="width:6px;height:6px;border-radius:50%;background:var(--@(StatusMaps.Dot(s.Health))-dot)"></span>
                        @s.P95
                    </span>
                    <span style="display:inline-flex;align-items:center;gap:5px"><i class="ti ti-files" style="font-size:12px"></i>used in @s.UsedIn reports</span>
                </div>
            </div>
        }
    </div>

    <div style="font-size:12px;color:var(--fg-muted)">
        Didn't find it? <a href="#" style="color:var(--info-fg)">Register a new source</a> · <a href="#" style="color:var(--info-fg)">create a custom plugin</a>
    </div>

    <div class="wizard-footer">
        <Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Cancel</Button>
        <div style="display:flex;align-items:center;gap:12px">
            <span class="muted" style="font-size:12px">selected: <b class="mono" style="color:var(--fg)">@(_selected ?? "—")</b></span>
            <Button Variant="primary" IconRight="arrow-right" OnClick="Continue">Continue</Button>
        </div>
    </div>
</div>

@code {
    private readonly string[] Steps = { "Source", "Columns", "Format", "Destination", "Review" };
    private string _search = "";
    private string? _selected;
    private IReadOnlyList<string> _engineSources = Array.Empty<string>();

    protected override void OnInitialized() => _selected = Wizard.SourceId ?? "sales-db";

    protected override async Task OnInitializedAsync()
    {
        ApiCapabilities? capabilities = await Api.TryGetCapabilitiesAsync();
        Wizard.EngineAvailable = capabilities is { Sources.Count: > 0 };
        if (!Wizard.EngineAvailable)
            return;

        _engineSources = capabilities!.Sources;
        if (!_engineSources.Contains(Wizard.SourceType))
            Wizard.SourceType = _engineSources.Contains("sql") ? "sql" : _engineSources[0];
    }

    private IEnumerable<SourceSummary> Filtered =>
        SampleData.Sources.Where(s => string.IsNullOrWhiteSpace(_search)
            || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || s.Type.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void Continue()
    {
        Wizard.SourceId = _selected;
        Nav.NavigateTo("builder/configure");
    }
}
