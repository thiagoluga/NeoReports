@page "/builder"
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject BuilderState Wizard
@inject INeoReportsApiClient Api

<div class="page">
    <WizardStepper Steps="Steps" Current="0" />

    <div class="page-head">
        <div class="title">
            <h1>Choose the data source</h1>
            <div class="sub">Pick the engine source type · step 1 of 5</div>
        </div>
    </div>

    @if (!Wizard.EngineAvailable)
    {
        <Banner Variant="info" Icon="info-circle">
            <b>Demo mode</b>
            <span style="font-size:12px">No engine capabilities were found — you can still browse the wizard, but "Save" is disabled at the end.</span>
        </Banner>
    }
    else
    {
        <Card Title="Engine source type" Sub="What POST /api/reports actually reads from">
            <ChildContent>
            <div class="field">
                <span class="label-sm">Type</span>
                <select class="input mono" style="width:100%;max-width:280px" @bind="Wizard.SourceType">
                    @foreach (var type in _engineSources)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            </ChildContent>
        </Card>
    }

    <div class="wizard-footer">
        <Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Cancel</Button>
        <div style="display:flex;align-items:center;gap:12px">
            <Button Variant="primary" IconRight="arrow-right" OnClick="Continue">Continue</Button>
        </div>
    </div>
</div>

@code {
    private readonly string[] Steps = { "Source", "Columns", "Format", "Destination", "Review" };
    private IReadOnlyList<string> _engineSources = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        ApiCapabilities? capabilities = await Api.TryGetCapabilitiesAsync();
        Wizard.EngineAvailable = capabilities is { Sources.Count: > 0 };
        if (!Wizard.EngineAvailable)
            return;

        _engineSources = capabilities!.Sources;
        if (!_engineSources.Contains(Wizard.SourceType))
            Wizard.SourceType = _engineSources.Contains("sql") ? "sql" : _engineSources[0];
    }

    private void Continue() => Nav.NavigateTo("builder/configure");
}
