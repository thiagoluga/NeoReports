@page "/builder"
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject BuilderState Wizard
@inject INeoReportsApiClient Api

<div class="page">
    <WizardStepper Steps="Steps" Current="0" />

    <div class="page-head">
        <div class="title">
            <h1>Choose the data source</h1>
            <div class="sub">Pick the engine source type · step 1 of 5</div>
        </div>
    </div>

    @if (Wizard.IsEditing && string.IsNullOrEmpty(Wizard.SourceType) && string.IsNullOrEmpty(Wizard.SourceRef))
    {
        <Banner Variant="warn" Icon="alert-triangle">
            <b>Confirm the source type.</b>
            <span style="font-size:12px">"@Wizard.EditingOriginalName" has no source type in its stored configuration. Pick the correct one below; saving with the wrong type would silently change what the report reads from.</span>
        </Banner>
    }
    else if (Wizard.IsEditing)
    {
        <Banner Variant="info" Icon="info-circle">
            <b>Editing "@Wizard.EditingOriginalName".</b>
            <span style="font-size:12px">Every step is prefilled from the report's stored configuration. Values the engine holds back — connection strings, API tokens — are kept as they are unless you replace them.</span>
        </Banner>
    }
    @if (_configUnavailable)
    {
        <Banner Variant="danger" Icon="alert-triangle">
            @if (_configOutcome == ApiConfigOutcome.NotFound)
            {
                <b>That report has no stored configuration to edit.</b>
                <span style="font-size:12px">It was deleted, or it is registered in code — either way there is nothing here to change. Nothing was prefilled, so this is a blank new report.</span>
            }
            else
            {
                <b>Could not load that report's configuration.</b>
                <span style="font-size:12px">Nothing was prefilled, so this is a blank new report — saving it would not edit the one you came from. Go back and try again.</span>
            }
        </Banner>
    }
    @if (!Wizard.EngineAvailable)
    {
        <Banner Variant="info" Icon="info-circle">
            <b>Demo mode</b>
            <span style="font-size:12px">No engine capabilities were found — you can still browse the wizard, but "Save" is disabled at the end.</span>
        </Banner>
    }
    else
    {
        @* Registered sources (ADR D42) — reference one by name instead of an inline connection.
           Only shown when the host has at least one; otherwise the inline picker below is the only path. *@
        @if (_registeredSources.Count > 0)
        {
            <Card Title="Use a registered source" Sub="Reference a named source instead of an inline connection">
                <ChildContent>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
                    <SelectableCard Selected="@(string.IsNullOrEmpty(Wizard.SourceRef))" OnClick="@(() => Wizard.SourceRef = "")">
                        <CatTile Kind="gray" Icon="plug-connected" />
                        <div class="name">Enter connection manually</div>
                        <div class="conn">Inline type + connection string variable, below</div>
                    </SelectableCard>
                    @foreach (var source in _registeredSources)
                    {
                        <SelectableCard Selected="@(Wizard.SourceRef == source.Name)" OnClick="@(() => SelectSourceRef(source))">
                            <div class="name">@source.Name <span class="type-pill">@source.Type</span></div>
                            <div class="conn">@(string.IsNullOrWhiteSpace(source.Description) ? "No description" : source.Description)</div>
                        </SelectableCard>
                    }
                </div>
                </ChildContent>
            </Card>
        }

        @if (string.IsNullOrEmpty(Wizard.SourceRef))
        {
            <Card Title="Engine source type" Sub="What POST /api/reports actually reads from">
                <ChildContent>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
                    @foreach (var type in _engineSources)
                    {
                        <SelectableCard Selected="@(Wizard.SourceType == type)" OnClick="@(() => SelectSourceType(type))">
                            <CatTile Kind="teal" Icon="database" />
                            <div class="name mono">@type</div>
                            <div class="conn">Registered <span class="mono">IConfigSourceProvider</span></div>
                        </SelectableCard>
                    }
                </div>
                </ChildContent>
            </Card>
        }
    }

    <div class="wizard-footer">
        <Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Cancel</Button>
        <div style="display:flex;align-items:center;gap:12px">
            <Button Variant="primary" IconRight="arrow-right" Disabled="@NoSourceTypeChosenYet" OnClick="Continue">Continue</Button>
        </div>
    </div>
</div>

@code {
    private readonly string[] Steps = { "Source", "Columns", "Format", "Destination", "Review" };
    private IReadOnlyList<string> _engineSources = Array.Empty<string>();
    private IReadOnlyList<ApiSourceView> _registeredSources = Array.Empty<ApiSourceView>();

    /// <summary>Whether the registered-source list actually loaded, as opposed to failing to.</summary>
    private bool _sourcesLoaded;

    /// <summary>Set when an edit was asked for and the report's configuration could not be read.</summary>
    private bool _configUnavailable;

    /// <summary>Why it could not be read, so the message can say which of the two happened.</summary>
    private ApiConfigOutcome _configOutcome = ApiConfigOutcome.Ok;

    /// <summary>
    /// Set by ReportDetail's "Edit" button (<c>?edit=name</c>) — hydrates the wizard from that
    /// report instead of starting blank.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "edit")]
    public string? EditName { get; set; }

    /// <summary>
    /// Set only by the wizard's own internal "Back"/"Change"/"edit" links that return to step 1
    /// (<c>?resume=true</c>) — every other route to <c>/builder</c> discards the Scoped
    /// <see cref="BuilderState"/> by default. Defaulting to reset (D69, DECISIONS.md) keeps a
    /// forgotten-on-a-new-entry-point mistake safe (a blank wizard) rather than dangerous
    /// (silently reusing a previous report's fields).
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "resume")]
    public bool IsResuming { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string? editName = string.IsNullOrWhiteSpace(EditName) ? null : EditName;
        if (editName is null && !IsResuming)
            Wizard.Reset();

        ApiCapabilities? capabilities = await Api.TryGetCapabilitiesAsync();
        if (capabilities is not { Sources.Count: > 0 })
        {
            // Nothing to hydrate against and nothing to save to; the wizard stays browsable. Only
            // the edit path resets here — a mid-wizard "Back" must keep what the user already typed
            // (D69), and an unreachable engine is no reason to throw it away.
            if (editName is not null)
                Wizard.Reset();

            Wizard.EngineAvailable = false;
            return;
        }

        _engineSources = capabilities.Sources;

        // null means the call failed, which is NOT the same as "this host has no registered sources".
        // Conflating them cleared an edited report's source.ref on a transient blip and saved it back
        // as an inline source — a silent repointing of what the report reads from.
        IReadOnlyList<ApiSourceView>? registered = await Api.TryListSourcesAsync();
        _sourcesLoaded = registered is not null;
        _registeredSources = registered ?? Array.Empty<ApiSourceView>();

        // Loaded after the registered sources on purpose: a ref-based document names a source but
        // not its type (the type belongs to the registry, D42), and the Configure step's editor
        // shape depends on knowing it.
        if (editName is not null)
            await LoadForEditAsync(editName);

        // Set last, because Reset() clears it and both paths above may have called it.
        Wizard.EngineAvailable = true;

        // Not editing: an unrecognized/blank type (e.g. right after Reset()'s "sql" default, on a
        // host that doesn't register a "sql" provider) falls back to the first available type. While
        // editing, a blank type means the stored document genuinely had none — left blank so nothing
        // looks pre-selected and Continue stays disabled until the user confirms one.
        if (!Wizard.IsEditing && !_engineSources.Contains(Wizard.SourceType))
            Wizard.SourceType = _engineSources.Contains("sql") ? "sql" : _engineSources[0];

        if (_sourcesLoaded && !string.IsNullOrEmpty(Wizard.SourceRef) && _registeredSources.All(s => s.Name != Wizard.SourceRef))
            Wizard.SourceRef = "";
    }

    /// <summary>
    /// Prefills the whole wizard from the report's stored configuration document
    /// (<c>GET /api/reports/{name}/config</c>, ADR D86) — source type/ref, query, key column,
    /// properties, columns, formats, destination and path, resilience and schedule.
    /// <para>
    /// Values the engine redacts (connection strings, tokens) come back as a placeholder and are
    /// preserved on save without ever being shown; see <see cref="BuilderConfigMapper"/>.
    /// </para>
    /// </summary>
    private async Task LoadForEditAsync(string name)
    {
        Wizard.Reset();

        ApiConfigResult config = await Api.TryGetReportConfigAsync(name);

        // "Could not load it" is not "it is not editable" — the same conflation _sourcesLoaded fixes
        // above. Silently degrading to a blank create wizard on a transient failure would invite the
        // user to type a whole report over a working one.
        // NotFound counts too: Edit is only offered for a config-origin report, so a 404 here means it
        // was deleted or is code-registered — either way the user asked to edit something and must not
        // be handed a blank create form without a word.
        // Ok with no document cannot happen through the client, but matching the document out rather
        // than asserting it keeps that from becoming a null dereference if it ever does.
        _configOutcome = config.Outcome;
        _configUnavailable = config is not { Outcome: ApiConfigOutcome.Ok, Document: { } document }
            || !BuilderConfigMapper.Hydrate(Wizard, document, RegisteredSourceType);

        // Kept whatever the outcome: Hydrate clears it through Reset(), and a null here simply means
        // the save states no precondition, which is the pre-D87 behaviour rather than a failure.
        Wizard.OriginalVersion = config.Version;

        if (_configUnavailable)
            return;

        Wizard.IsEditing = true;
        Wizard.EditingOriginalName = name;
    }

    private string? RegisteredSourceType(string sourceRef) =>
        _registeredSources.FirstOrDefault(s => string.Equals(s.Name, sourceRef, StringComparison.Ordinal))?.Type;

    /// <summary>
    /// True only in edit mode, before the user has (re-)confirmed a source type (see
    /// <see cref="LoadForEditAsync"/> — the engine doesn't return a compiled report's source type,
    /// so it's deliberately left blank rather than defaulted). Gates Continue so a missed "Confirm
    /// the source type" banner can't silently carry an unconfigured Configure step forward; stays
    /// false whenever the engine is unreachable (demo mode), which already browses with a blank type.
    /// </summary>
    private bool NoSourceTypeChosenYet =>
        Wizard.EngineAvailable && string.IsNullOrEmpty(Wizard.SourceType) && string.IsNullOrEmpty(Wizard.SourceRef);

    /// <summary>
    /// Switching to a different engine source type clears any generic property rows from whatever
    /// type was previously selected (ADR D42's editor) — they're almost certainly the wrong shape
    /// for the new type (e.g. an HTTP source's "url"/"strategy" rows are meaningless for Salesforce).
    /// The Configure step re-seeds a single blank row once this leaves the list empty.
    /// </summary>
    private void SelectSourceType(string type)
    {
        if (Wizard.SourceType != type)
            Wizard.SourceProperties.Clear();

        Wizard.SourceType = type;
    }

    private void SelectSourceRef(ApiSourceView source)
    {
        if (Wizard.SourceType != source.Type)
            Wizard.SourceProperties.Clear();

        Wizard.SourceRef = source.Name;
        Wizard.SourceType = source.Type;
    }

    private void Continue() => Nav.NavigateTo("builder/configure");
}
