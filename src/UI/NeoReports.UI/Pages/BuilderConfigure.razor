@page "/builder/configure"
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject BuilderState Wizard
@inject INeoReportsApiClient Api

<div class="page">
    <WizardStepper Steps="Steps" Current="1" />

    <div class="page-head">
        <div class="title">
            <h1>Configure the source</h1>
            <div class="sub">Set the query, parameters, pagination and resilience · step 2 of 5</div>
        </div>
    </div>

    @* Recap *@
    <div class="recap">
        <CatTile Kind="teal" Icon="database" />
        <div style="min-width:0">
            <div class="r-name">@(Wizard.SourceId ?? "sales-db") <span class="muted" style="font-weight:400;font-size:12px">· SQL Server</span></div>
            <div class="r-meta">Server=tcp:sales.prod.acme.local,1433;Initial Catalog=sales;Encrypt=true</div>
        </div>
        <button class="btn link" @onclick="@(() => Nav.NavigateTo("builder"))">Change →</button>
    </div>

    @* Engine configuration — the fields that actually build the ReportConfig sent to the
       engine (Epic D / D6). Everything below Resilience on this page stays cosmetic. *@
    <Card Title="Engine configuration" Sub="What gets sent to POST /api/reports">
        <Action>
            <Button Variant="outline" Size="sm" Icon="circle-check" Loading="_validating" OnClick="ValidateAsync">Validate</Button>
        </Action>
        <ChildContent>
        <div class="col" style="gap:12px">
            <div class="grid-2">
                <div class="field"><span class="label-sm">Report name</span><span class="input mono"><input class="mono" @bind="Wizard.ReportName" @bind:event="oninput" placeholder="monthly-sales" style="width:100%" /></span></div>
                <div class="field"><span class="label-sm">Connection string variable</span><span class="input mono"><span class="mono muted" style="font-size:11px">${</span><input class="mono" @bind="Wizard.ConnectionStringVariable" @bind:event="oninput" placeholder="SALES_DB" style="flex:1" /><span class="mono muted" style="font-size:11px">}</span></span></div>
            </div>
            <div class="field">
                <span class="label-sm">SQL query</span>
                <textarea class="stack mono" style="width:100%;min-height:120px;background:var(--bg2);color:var(--fg);border:0.5px solid var(--border);border-radius:var(--r-md);padding:10px 12px;resize:vertical" @bind="Wizard.SqlQuery" @bind:event="oninput" placeholder="SELECT Id, Customer, Amount FROM Sales ORDER BY Id"></textarea>
            </div>
            <div class="grid-2">
                <div class="field"><span class="label-sm">Key column</span><span class="input mono"><input class="mono" @bind="Wizard.KeyColumn" @bind:event="oninput" style="width:100%" /></span></div>
                <div class="field"><span class="label-sm">Page size</span><span class="input num"><input class="mono" type="number" min="1" @bind="Wizard.PageSize" @bind:event="oninput" /></span></div>
            </div>
            <div class="field"><span class="label-sm">Output columns</span><span class="input mono"><input class="mono" @bind="Wizard.ColumnNames" @bind:event="oninput" placeholder="Id, Customer, Amount" style="width:100%" /></span></div>
        </div>
        @if (_validationResult is not null)
        {
            <div style="margin-top:12px">
                @if (_validationResult.Valid)
                {
                    <Banner Variant="success" Icon="circle-check">
                        <b>Valid</b>
                        <span class="mono" style="font-size:12px">columns: @string.Join(", ", _validationResult.Columns ?? Array.Empty<string>())@(_validationResult.NameTaken ? " · name already taken" : "")</span>
                    </Banner>
                }
                else
                {
                    <Banner Variant="danger" Icon="alert-triangle">
                        <b>Invalid configuration</b>
                        <span style="font-size:12px">@_validationResult.Error</span>
                    </Banner>
                }
            </div>
        }
        else if (_validationUnavailable)
        {
            <div style="margin-top:12px">
                <Banner Variant="danger" Icon="alert-triangle"><b>Could not reach the engine to validate.</b></Banner>
            </div>
        }
        </ChildContent>
    </Card>

    @* Query preview — decorative, matches the prototype's syntax-highlighted mockup *@
    <Card Title="Query preview" Sub="@("Illustrative only — the field above is what's sent")">
        <ChildContent>
        <pre class="stack" style="background:var(--bg2);color:var(--fg)"><span style="color:var(--fg-faint);font-style:italic">-- sales in period by tenant</span>
<span class="kw">SELECT</span> v.id, v.customer_id, v.total, v.created_at, v.status_id, v.region
<span class="kw">FROM</span> <span class="tk">sales</span> v
<span class="kw">INNER JOIN</span> <span class="tk">customers</span> c <span class="kw">ON</span> c.id = v.customer_id
<span class="kw">WHERE</span> v.created_at <span class="kw">BETWEEN</span> <span class="tk">@@since</span> <span class="kw">AND</span> <span class="tk">@@until</span>
  <span class="kw">AND</span> c.tenant_id = <span class="tk">@@tenant</span>
<span class="kw">ORDER BY</span> v.id <span class="kw">ASC</span>;</pre>
        </ChildContent>
    </Card>

    @* Parameters *@
    <Card Title="Parameters" Sub="Substituted at runtime · types validated">
        <table class="tbl">
            <thead><tr><th>Name</th><th>Default value</th><th>Type</th><th>Source</th><th style="width:40px"></th></tr></thead>
            <tbody>
                @foreach (var p in _params)
                {
                    <tr>
                        <td class="mono"><span style="color:var(--info-fg)">@p.Name</span></td>
                        <td><span class="input mono" style="min-width:180px;height:28px"><input class="mono" value="@p.Val" style="width:100%" /></span></td>
                        <td><span class="input mono" style="height:28px;min-width:110px;justify-content:space-between"><span>@p.Type</span><i class="ti ti-chevron-down" style="font-size:12px;color:var(--fg-muted)"></i></span></td>
                        <td><span class="input mono" style="height:28px;min-width:110px;justify-content:space-between"><span>@p.Origin</span><i class="ti ti-chevron-down" style="font-size:12px;color:var(--fg-muted)"></i></span></td>
                        <td><button class="btn icon-only sm subtle"><i class="ti ti-x"></i></button></td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="padding:10px 0 2px"><Button Variant="link" Icon="plus">Add parameter</Button></div>
    </Card>

    @* Pagination *@
    <Card Title="Pagination" Sub="How large result sets are read in batches">
        <div>
            <div class="cgr"><span class="lbl">Strategy</span><div class="ctl">
                <ChipGroup Options="_pagOpts" Value="_pag" ValueChanged="v => _pag = v" />
                <span class="hint">recommended for SQL with an indexed ORDER BY</span>
            </div></div>
            <div class="cgr"><span class="lbl">Key column</span><div class="ctl"><Dropdown Value="v.id (bigint)" /></div></div>
            <div class="cgr"><span class="lbl">Page size</span><div class="ctl"><span class="input num"><input class="mono" value="1000" /></span><span class="hint">rows/page · est. ~42 pages</span></div></div>
            <div class="cgr"><span class="lbl">Ordering</span><div class="ctl"><ChipGroup Options="_sortOpts" Value="_sort" ValueChanged="v => _sort = v" /><span class="hint">deterministic · honored on retries</span></div></div>
        </div>
    </Card>

    @* Resilience *@
    <Card Title="Resilience" Sub="Retry, backoff and abort policy">
        <div>
            <div class="cgr"><span class="lbl">Max attempts</span><div class="ctl"><span class="input num"><input class="mono" value="5" /></span><span class="hint">counted per page, not per job</span></div></div>
            <div class="cgr"><span class="lbl">Backoff</span><div class="ctl">
                <ChipGroup Options="_backoffOpts" Value="_backoff" ValueChanged="v => _backoff = v" />
                <span class="hint">base</span><span class="input num"><input class="mono" value="2s" /></span>
                <span class="hint">max</span><span class="input num"><input class="mono" value="30s" /></span>
            </div></div>
            <div class="cgr"><span class="lbl">Jitter</span><div class="ctl"><Switch @bind-Value="_jitter" /><span class="hint">adds random variation to backoff · avoids thundering herd</span></div></div>
            <div class="cgr"><span class="lbl">Retry on errors</span><div class="ctl">
                <div class="row" style="flex-wrap:wrap;gap:4px">
                    @foreach (var e in _errorTypes)
                    {
                        <Pill Active="_retryErrors.Contains(e)" OnClick="@(() => ToggleErr(e))">
                            @if (_retryErrors.Contains(e)) { <i class="ti ti-check"></i> }
                            @e
                        </Pill>
                    }
                </div>
            </div></div>
            <div class="cgr"><span class="lbl">On failure</span><div class="ctl"><Dropdown Value="save partial + alert" /></div></div>
            <div class="cgr"><span class="lbl">Abort when</span><div class="ctl">
                <div class="col" style="gap:8px;width:100%">
                    <div class="row" style="gap:10px"><Switch @bind-Value="_abortConsec" /><span style="font-size:13px;min-width:160px">Consecutive failures</span><span class="input num"><input class="mono" value="3" /></span></div>
                    <div class="row" style="gap:10px"><Switch @bind-Value="_abortTotal" /><span style="font-size:13px;min-width:160px">Total failures</span><span class="input num"><input class="mono" value="10" /></span></div>
                    <div class="row" style="gap:10px"><Switch @bind-Value="_abortRate" /><span style="font-size:13px;min-width:160px">Error rate</span><span class="input num"><input class="mono" value="10%" /></span></div>
                </div>
            </div></div>
        </div>
    </Card>

    <div class="wizard-footer">
        <Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("builder"))">Back</Button>
        <Button Variant="primary" IconRight="arrow-right" OnClick="@(() => Nav.NavigateTo("builder/format"))">Continue</Button>
    </div>
</div>

@code {
    private readonly string[] Steps = { "Source", "Columns", "Format", "Destination", "Review" };

    private sealed record P(string Name, string Val, string Type, string Origin);
    private readonly P[] _params =
    {
        new("@@since", "@@now-1month", "datetime", "expression"),
        new("@@until", "@@now", "datetime", "expression"),
        new("@@tenant", "acme-prod", "string", "literal"),
    };

    private string _pag = "keyset", _sort = "ASC", _backoff = "exponential";
    private bool _jitter = true, _abortConsec = true, _abortTotal = false, _abortRate = true;
    private readonly (string, string)[] _pagOpts = { ("offset","offset"), ("keyset","keyset"), ("cursor","cursor"), ("token","token") };
    private readonly (string, string)[] _sortOpts = { ("ASC","ASC"), ("DESC","DESC") };
    private readonly (string, string)[] _backoffOpts = { ("linear","linear"), ("exponential","exponential"), ("fixed","fixed") };
    private readonly string[] _errorTypes = { "deadlock", "lock-timeout", "network", "5xx", "429", "custom" };
    private readonly HashSet<string> _retryErrors = new() { "deadlock", "lock-timeout", "network", "5xx", "429" };
    private void ToggleErr(string e) { if (!_retryErrors.Add(e)) _retryErrors.Remove(e); }

    private bool _validating;
    private bool _validationUnavailable;
    private ApiValidationResult? _validationResult;

    private async Task ValidateAsync()
    {
        _validating = true;
        _validationResult = null;
        _validationUnavailable = false;
        try
        {
            string configJson = BuilderConfigMapper.ToConfigJson(Wizard);
            _validationResult = await Api.TryValidateReportAsync(configJson);
            _validationUnavailable = _validationResult is null;
        }
        finally
        {
            _validating = false;
        }
    }
}
