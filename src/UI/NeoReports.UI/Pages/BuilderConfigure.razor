@page "/builder/configure"
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject BuilderState Wizard
@inject INeoReportsApiClient Api

<div class="page">
    <WizardStepper Steps="Steps" Current="1" />

    <div class="page-head">
        <div class="title">
            <h1>Configure the source</h1>
            <div class="sub">Set the source properties and resilience policy · step 2 of 5</div>
        </div>
    </div>

    @* Recap — reflects the real engine source type/connection variable (or registered source
       reference, ADR D42) picked in step 1, not the decorative source card. *@
    <div class="recap">
        <CatTile Kind="teal" Icon="database" />
        <div style="min-width:0">
            @if (!string.IsNullOrEmpty(Wizard.SourceRef))
            {
                <div class="r-name">@Wizard.SourceRef <span class="muted" style="font-weight:400;font-size:12px">· registered source (@Wizard.SourceType)</span></div>
                <div class="r-meta">connection resolved from the registry on every run</div>
            }
            else
            {
                <div class="r-name">@Wizard.SourceType <span class="muted" style="font-weight:400;font-size:12px">· engine source type</span></div>
                <div class="r-meta">@(string.IsNullOrWhiteSpace(Wizard.ConnectionStringVariable) ? "no connection string variable set" : $"${{{Wizard.ConnectionStringVariable}}}")</div>
            }
        </div>
        <button class="btn link" @onclick="@(() => Nav.NavigateTo("builder"))">Change →</button>
    </div>

    @* Engine configuration — the fields that actually build the ReportConfig sent to the
       engine (Epic D / D6). Everything below Resilience on this page stays cosmetic. *@
    <Card Title="Engine configuration" Sub="What gets sent to POST /api/reports">
        <Action>
            <Button Variant="outline" Size="sm" Icon="circle-check" Loading="_validating" OnClick="ValidateAsync">Validate</Button>
        </Action>
        <ChildContent>
        @if (Wizard.IsEditing && string.IsNullOrEmpty(Wizard.SourceRef))
        {
            <Banner Variant="warn" Icon="alert-triangle">
                <b>Re-enter the source properties and connection.</b>
                <span style="font-size:12px">The engine never returns a report's raw source properties, even when editing — same security boundary as registered sources. Everything else below was prefilled from "@Wizard.EditingOriginalName".</span>
            </Banner>
        }
        <div class="col" style="gap:12px">
            <div class="grid-2">
                <div class="field"><span class="label-sm">Report name</span><span class="input mono"><input class="mono" @bind="Wizard.ReportName" @bind:event="oninput" placeholder="monthly-sales" readonly="@Wizard.IsEditing" style="width:100%" /></span></div>
                @if (string.IsNullOrEmpty(Wizard.SourceRef))
                {
                    <div class="field"><span class="label-sm">Connection string variable</span><span class="input mono"><span class="mono muted" style="font-size:11px">${</span><input class="mono" @bind="Wizard.ConnectionStringVariable" @bind:event="oninput" placeholder="SALES_DB" style="flex:1" /><span class="mono muted" style="font-size:11px">}</span></span></div>
                }
                else
                {
                    <div class="field"><span class="label-sm">Connection</span><span class="muted" style="font-size:12px;align-self:center">resolved from <span class="mono">@Wizard.SourceRef</span> on every run</span></div>
                }
            </div>
            @if (Wizard.UsesAdoSqlShape)
            {
                <div class="field">
                    <span class="label-sm">SQL query</span>
                    <textarea class="stack mono" style="width:100%;min-height:120px;background:var(--bg2);color:var(--fg);border:0.5px solid var(--border);border-radius:var(--r-md);padding:10px 12px;resize:vertical" @bind="Wizard.SqlQuery" @bind:event="oninput" placeholder="SELECT Id, Customer, Amount FROM Sales ORDER BY Id"></textarea>
                </div>
                <div class="grid-2">
                    <div class="field"><span class="label-sm">Key column</span><span class="input mono"><input class="mono" @bind="Wizard.KeyColumn" @bind:event="oninput" style="width:100%" /></span></div>
                    <div class="field"><span class="label-sm">Page size</span><span class="input num"><input class="mono" type="number" min="1" @bind="Wizard.PageSize" @bind:event="oninput" /></span></div>
                </div>
            }
            else
            {
                <div class="field">
                    <span class="label-sm">Source properties <span class="muted" style="font-weight:400">— use <span class="mono">${VAR}</span> for secrets</span></span>
                    <span class="muted mono" style="font-size:11px;display:block;margin-bottom:6px">Common for "@Wizard.SourceType": @PropertyHintFor(Wizard.SourceType)</span>
                    <PropertyListEditor Rows="Wizard.SourceProperties" KeyPlaceholder="url" ValuePlaceholder="https://api.example.com" />
                </div>
                <div class="field"><span class="label-sm">Page size</span><span class="input num"><input class="mono" type="number" min="1" @bind="Wizard.PageSize" @bind:event="oninput" /></span></div>
            }
            <div class="field"><span class="label-sm">Output columns</span><span class="input mono"><input class="mono" @bind="Wizard.ColumnNames" @bind:event="oninput" placeholder="Id, Customer, Amount" style="width:100%" /></span></div>
            <div class="cgr"><span class="lbl">Track progress</span><div class="ctl"><Switch @bind-Value="Wizard.TrackProgress" /><span class="hint">counts the source rows once before each run · enables a real completion percentage</span></div></div>
            @if (!Wizard.TrackProgress)
            {
                <Banner Variant="warn" Icon="alert-triangle">
                    <b>No completion percentage.</b>
                    <span style="font-size:12px">Without the row count, the running-job page shows an indeterminate progress bar; read/written counters and rates stay exact.</span>
                </Banner>
            }
        </div>
        @if (_validationResult is not null)
        {
            <div style="margin-top:12px">
                @if (_validationResult.Valid)
                {
                    <Banner Variant="success" Icon="circle-check">
                        <b>Valid</b>
                        <span class="mono" style="font-size:12px">columns: @string.Join(", ", _validationResult.Columns ?? Array.Empty<string>())@(_validationResult.NameTaken ? " · name already taken" : "")</span>
                    </Banner>
                }
                else
                {
                    <Banner Variant="danger" Icon="alert-triangle">
                        <b>Invalid configuration</b>
                        <span style="font-size:12px">@_validationResult.Error</span>
                    </Banner>
                }
            </div>
        }
        else if (_validationUnavailable)
        {
            <div style="margin-top:12px">
                <Banner Variant="danger" Icon="alert-triangle"><b>Could not reach the engine to validate.</b></Banner>
            </div>
        }
        </ChildContent>
    </Card>

    @* Resilience — Max attempts/Backoff/Base delay/Jitter/On failure/Abort-when, sent as
       resilience.* in POST /api/reports (Epic D / D34, abort-when per D37). Per-exception-type
       retry filtering has no config-document equivalent (Polly retries any exception uniformly)
       and stays rejected (D37) — that control was removed rather than shown as decoration (D36). *@
    <Card Title="Resilience" Sub="Retry, backoff and abort policy">
        <div>
            <div class="cgr"><span class="lbl">Max attempts</span><div class="ctl"><span class="input num"><input class="mono" type="number" min="1" @bind="Wizard.RetryMaxAttempts" @bind:event="oninput" /></span><span class="hint">counted per page, not per job</span></div></div>
            <div class="cgr"><span class="lbl">Backoff</span><div class="ctl">
                <ChipGroup Options="_backoffOpts" Value="Wizard.RetryBackoff" ValueChanged="v => Wizard.RetryBackoff = v" />
                <span class="hint">base</span><span class="input num"><input class="mono" type="number" min="0" step="0.5" @bind="Wizard.RetryBaseDelaySeconds" @bind:event="oninput" style="width:60px" /></span>
                <span class="mono muted" style="font-size:11px">seconds</span>
            </div></div>
            <div class="cgr"><span class="lbl">Jitter</span><div class="ctl"><Switch @bind-Value="Wizard.RetryJitter" /><span class="hint">adds random variation to backoff · avoids thundering herd</span></div></div>
            <div class="cgr"><span class="lbl">On failure</span><div class="ctl">
                <select class="input mono" style="min-width:180px" @bind="Wizard.FailureStrategy">
                    <option value="abort">abort</option>
                    <option value="skip-and-log">skip-and-log</option>
                </select>
            </div></div>
            @if (Wizard.FailureStrategy == "skip-and-log")
            {
                <div class="cgr"><span class="lbl">Abort when</span><div class="ctl col" style="align-items:flex-start;gap:6px">
                    <div style="display:flex;align-items:center;gap:8px">
                        <Switch @bind-Value="Wizard.AbortOnConsecutiveFailures" />
                        <span class="input num"><input class="mono" type="number" min="1" @bind="Wizard.AbortConsecutiveFailures" @bind:event="oninput" disabled="@(!Wizard.AbortOnConsecutiveFailures)" style="width:70px" /></span>
                        <span class="hint">consecutive failures</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px">
                        <Switch @bind-Value="Wizard.AbortOnTotalFailures" />
                        <span class="input num"><input class="mono" type="number" min="1" @bind="Wizard.AbortTotalFailures" @bind:event="oninput" disabled="@(!Wizard.AbortOnTotalFailures)" style="width:70px" /></span>
                        <span class="hint">total failures</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px">
                        <Switch @bind-Value="Wizard.AbortOnFailureRate" />
                        <span class="input num"><input class="mono" type="number" min="1" max="100" step="1" @bind="Wizard.AbortFailureRatePercent" @bind:event="oninput" disabled="@(!Wizard.AbortOnFailureRate)" style="width:70px" /></span>
                        <span class="hint">% failure rate</span>
                    </div>
                </div></div>
            }
        </div>
    </Card>

    <div class="wizard-footer">
        <Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("builder"))">Back</Button>
        <Button Variant="primary" IconRight="arrow-right" OnClick="@(() => Nav.NavigateTo("builder/format"))">Continue</Button>
    </div>
</div>

@code {
    private readonly string[] Steps = { "Source", "Columns", "Format", "Destination", "Review" };
    private readonly (string, string)[] _backoffOpts = { ("Constant","constant"), ("Exponential","exponential") };

    // Presentation-only discoverability hint (not sent to the engine, not validated) — the engine's
    // capabilities endpoint reports only type-id strings, no property-shape metadata, so this is a
    // manually-synced, best-effort pointer rather than a schema; falls back gracefully for any type
    // not listed (a future/custom IConfigSourceProvider).
    private static readonly Dictionary<string, string> PropertyHints = new(StringComparer.OrdinalIgnoreCase)
    {
        ["mongodb"] = "database, collection, key, pageSize (connectionString comes from the field above)",
        ["csv"] = "path (or bucket + key for S3), hasHeader, delimiter",
        ["xlsx"] = "path (or bucket + key for S3), hasHeader, sheetName",
        ["parquet"] = "path (or bucket + key for S3)",
        ["http"] = "url, strategy, recordsPath, bearerToken (or oauth2TokenEndpoint/oauth2ClientId/oauth2ClientSecret)",
        ["odata"] = "url, strategy, recordsPath, filter, select, orderby, top",
        ["graphql"] = "url, query, connectionPath, variables, nodePath",
        ["elasticsearch"] = "url, index, sort, query",
        ["hubspot"] = "objectType, baseUrl, properties",
        ["airtable"] = "baseId, table, baseUrl",
        ["googlesheets"] = "spreadsheetId, sheet, apiKey, headerRow",
        ["salesforce"] = "instanceUrl, soql, bearerToken, apiVersion",
    };

    private static string PropertyHintFor(string type) =>
        PropertyHints.TryGetValue(type, out string? hint) ? hint : "check the source package's docs for its required properties";

    private bool _validating;
    private bool _validationUnavailable;
    private ApiValidationResult? _validationResult;

    protected override void OnInitialized()
    {
        if (!Wizard.UsesAdoSqlShape && Wizard.SourceProperties.Count == 0)
            Wizard.SourceProperties.Add(new PropertyRow());
    }

    private async Task ValidateAsync()
    {
        _validating = true;
        _validationResult = null;
        _validationUnavailable = false;
        try
        {
            string configJson = BuilderConfigMapper.ToConfigJson(Wizard);
            _validationResult = await Api.TryValidateReportAsync(configJson);
            _validationUnavailable = _validationResult is null;
        }
        finally
        {
            _validating = false;
        }
    }
}
