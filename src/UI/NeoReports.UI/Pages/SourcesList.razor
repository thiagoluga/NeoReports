@page "/sources"
@using NeoReports.UI.Services
@inject INeoReportsApiClient Api

<div class="page">
    <div class="page-head">
        <div class="title">
            <h1>Sources</h1>
            <div class="sub">Registered engine source types</div>
        </div>
    </div>

    @* GET /api/capabilities (Epic D / D9) — the engine only reports registered provider *types*
       (e.g. "sql"), not named source instances with health/latency; there's no source registry
       to show beyond that. A decorative catalog of fake named sources previously stood in for
       one — removed (D36); see docs/ui-removed-mock-content.md. *@
    @if (_engineSourceTypes.Count > 0)
    {
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
            @foreach (var type in _engineSourceTypes)
            {
                <div class="src-card">
                    <div class="sc-head">
                        <CatTile Kind="teal" Icon="database" />
                        <div class="info">
                            <div class="title-row"><span class="title mono">@type</span></div>
                            <span class="conn">Registered <span class="mono">IConfigSourceProvider</span></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <EmptyState Icon="database" Title="No source types registered">
            <ChildContent>The engine has no <span class="mono">IConfigSourceProvider</span> registered, or it's unreachable.</ChildContent>
        </EmptyState>
    }
</div>

@code {
    private IReadOnlyList<string> _engineSourceTypes = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        ApiCapabilities? capabilities = await Api.TryGetCapabilitiesAsync();
        _engineSourceTypes = capabilities?.Sources ?? Array.Empty<string>();
    }
}
