@page "/sources"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

<div class="page">
    <div class="page-head">
        <div class="title">
            <h1>Sources</h1>
            <div class="sub">Registered data sources · @SampleData.Sources.Count sources · 3 types</div>
        </div>
        <Button Variant="primary" Icon="plus">Register source</Button>
    </div>

    @* Engine source types — GET /api/capabilities (Epic D / D9). Additive: the decorative
       catalog below is unchanged, since capabilities only reports registered provider *types*
       (e.g. "sql"), not per-source name/health/latency — no per-source data to replace it with. *@
    @if (_engineSourceTypes.Count > 0)
    {
        <div>
            <p class="label-sm" style="margin-bottom:10px">Engine source types</p>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
                @foreach (var type in _engineSourceTypes)
                {
                    <div class="src-card">
                        <div class="sc-head">
                            <CatTile Kind="teal" Icon="database" />
                            <div class="info">
                                <div class="title-row"><span class="title mono">@type</span></div>
                                <span class="conn">Registered <span class="mono">IConfigSourceProvider</span></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Count strip — mock/future: health aggregates not exposed yet *@
    <div class="count-strip">
        <span class="c"><span class="dot" style="background:var(--success-dot)"></span><b>4</b> healthy</span>
        <span class="c"><span class="dot" style="background:var(--warn-dot)"></span><b>1</b> high latency</span>
        <span class="c"><span class="dot" style="background:var(--danger-dot)"></span><b>1</b> unavailable</span>
        <span class="c"><span class="dot" style="background:var(--fg-faint)"></span><b>3</b> types · SQL Server, PostgreSQL, MongoDB…</span>
    </div>

    <FilterBar @bind-Search="_search" Placeholder="Search by name or type">
        <Pill Icon="filter">Type</Pill>
        <Pill Icon="heart-rate-monitor">Status</Pill>
    </FilterBar>

    <div class="col" style="gap:10px">
        @foreach (var s in Filtered)
        {
            <SourceCard Source="s" OnExplore="@(() => Explore(s))" />
        }
    </div>
</div>

@code {
    private string _search = "";
    private IReadOnlyList<string> _engineSourceTypes = Array.Empty<string>();

    private IEnumerable<SourceSummary> Filtered =>
        SampleData.Sources.Where(s =>
            string.IsNullOrWhiteSpace(_search)
            || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || s.Type.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void Explore(SourceSummary s)
    {
        if (s.Health != Health.Error)
        {
            Nav.NavigateTo($"sources/{s.Id}/explore");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ApiCapabilities? capabilities = await Api.TryGetCapabilitiesAsync();
        _engineSourceTypes = capabilities?.Sources ?? Array.Empty<string>();
    }
}
