@page "/jobs/failed"
@page "/jobs/failed/{Id}"
@using NeoReports.UI.Components.UI
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

<div class="page">
    <div class="page-head">
        <div class="title">
            <div style="display:flex;align-items:center;gap:12px">
                <h1 style="font-size:24px">@Title</h1>
                <Badge Variant="danger" Icon="alert-triangle">Failed</Badge>
            </div>
            <div class="sub mono" style="margin-top:6px">job_@EffectiveId@SubLine</div>
        </div>
        <div style="display:flex;gap:8px">
            <Button Variant="outline" Icon="refresh" OnClick="RetryAsync">Retry</Button>
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>

    <div class="hero-status danger">
        <div class="badge-ico"><i class="ti ti-alert-triangle"></i></div>
        <div>
            <div class="title">@HeroTitle</div>
            <div class="sub">@HeroSub</div>
            <div class="sub mono" style="margin-top:4px">@HeroDetail</div>
        </div>
        <Button Variant="outline" Icon="external-link">View runbook</Button>
    </div>

    <Card Flat="true" Dense="true"><PhaseStepper Phases="_phases" /></Card>

    <div class="grid-4">
        <MetricCard Icon="download" Label="Read" Value="@ReadValue" Sub="partial" />
        <MetricCard Icon="upload" Label="Written" Value="@WrittenValue" Sub="partial" />
        <MetricCard Icon="clock" Label="Duration" Value="@DurationText" Sub="aborted before upload" />
        <MetricCard Icon="refresh" Label="Retries" Value="@RetriesValue" Sub="exhausted · no recovery" />
    </div>

    <Card Flat="true">
        <div class="file-row" style="border-top:0;padding:4px">
            <CatTile Sm="true" Kind="warn" Icon="file-alert" />
            <div class="file-name"><b style="font-family:var(--font-sans);font-size:13px">Partial output available</b><span>audit-2026-05-27.partial.json · 16,000 documents · 4.1 MB · not uploaded to Azure Blob</span></div>
            <div class="file-actions"><Button Variant="outline" Size="sm" Icon="download">Download partial</Button></div>
        </div>
    </Card>

    <Card Title="What to do now?" Sub="Three paths · ordered least to most destructive">
        <div>
            <div class="option-row recommended">
                <span class="opt-icon"><i class="ti ti-bookmark"></i></span>
                <div>
                    <div class="opt-title-row"><span class="opt-title">Resume from checkpoint</span><span class="badge info"><span class="dot"></span>recommended</span></div>
                    <div class="opt-desc">Continues from page 19 using the snapshot saved at 01:00:14. Skips the 18,000 rows already processed.</div>
                </div>
                <Button Variant="primary" Icon="player-play" Disabled="true">Resume</Button>
            </div>
            <div class="option-row">
                <span class="opt-icon"><i class="ti ti-rotate"></i></span>
                <div><div class="opt-title-row"><span class="opt-title">Run from scratch</span></div><div class="opt-desc">Discards the checkpoint and reruns everything. Slower, but safe if the source data changed.</div></div>
                <Button Variant="outline" Icon="player-play" OnClick="RetryAsync">Run</Button>
            </div>
            <div class="option-row">
                <span class="opt-icon"><i class="ti ti-pencil"></i></span>
                <div><div class="opt-title-row"><span class="opt-title">Edit configuration and retry</span></div><div class="opt-desc">Adjust threshold, retry policy or query before rerunning. Useful if the error is systematic.</div></div>
                <Button Variant="outline" Icon="pencil" OnClick="@(() => Nav.NavigateTo("builder"))">Edit</Button>
            </div>
        </div>
    </Card>

    <div class="grid-1-4">
        <Card Title="Stack trace" Sub="first and last line highlighted">
            @if (_job?.Error is { } error)
            {
                <pre class="stack"><span class="err">@error</span></pre>
            }
            else
            {
                <pre class="stack"><span class="err">System.TimeoutException: A timeout occurred reading from MongoDB cluster audit-mongo.prod after 30000ms.</span>
   at NeoReports.Sources.MongoSource.ReadPageAsync(Int32 page) in /src/Sources/MongoSource.cs:<span class="gray">142</span>
   at NeoReports.Engine.PipelineRunner.RunPhaseAsync(Phase phase) in /src/Engine/PipelineRunner.cs:<span class="gray">88</span>
   at NeoReports.Engine.PipelineRunner.RunAsync() in /src/Engine/PipelineRunner.cs:<span class="gray">54</span>
   at NeoReports.Workers.JobWorker.ExecuteAsync(Job job) in /src/Workers/JobWorker.cs:<span class="gray">31</span>

<span class="err">→ ThresholdMonitor.Abort: error rate 10.6% exceeded threshold 10% after 18,402 records. Job aborted to prevent inconsistent output.</span></pre>
            }
        </Card>

        <Card Title="Alerts fired" Sub="3 rules · 2 channels">
            @foreach (var a in _alerts)
            {
                <div class="list-row" style="padding:8px 0">
                    <CatTile Sm="true" Kind="@a.Kind" Icon="@a.Icon" />
                    <div class="col" style="gap:0"><span class="name">@a.Rule</span><span class="sub mono">fired at 01:01:22</span></div>
                    <div class="row" style="margin-left:auto;gap:4px">
                        @foreach (var c in a.Channels)
                        {
                            <span class="cat-tile sm gray" title="@c"><i class="ti ti-@c"></i></span>
                        }
                    </div>
                </div>
            }
        </Card>
    </div>
</div>

@code {
    // Nullable: with two @page templates (with/without {Id}), Blazor's router explicitly sets
    // unmatched route parameters to null on the parameterless route rather than leaving the
    // field's default — so the demo fallback lives in EffectiveId, not a field initializer.
    [Parameter] public string? Id { get; set; }
    private string EffectiveId => Id ?? "8b2f01a9";
    private ApiJobView? _job;

    private string Title => _job?.ReportName ?? "Daily audit log";
    private string SubLine => _job is not null
        ? $" · {_job.ReportName} · ended {_job.CompletedAt?.ToLocalTime():HH:mm:ss}"
        : " · schedule · ended 01:01:22 BRT";
    private string HeroTitle => _job is not null ? "Job failed" : "Failure threshold exceeded";
    private string HeroSub => _job?.Error
        ?? "Error rate above 10% after page 18. ThresholdMonitor aborted the run to avoid inconsistent output.";
    private string HeroDetail => _job is not null
        ? $"failed after {DurationText} · {_job.Stats.Retries} retries recorded"
        : "failed after 1m 22s · 15 retries exhausted · audit-mongo";
    private TimeSpan? Duration => _job?.StartedAt is { } s && _job.CompletedAt is { } c ? c - s : null;
    private string DurationText => Duration is { } d ? FormatSpan(d) : "1m 22s";
    private string ReadValue => _job is not null ? _job.Stats.RecordsRead.ToString("N0") : "18,402";
    private string WrittenValue => _job is not null ? _job.Stats.RecordsWritten.ToString("N0") : "16,000";
    private string RetriesValue => _job is not null ? _job.Stats.Retries.ToString() : "15";

    private readonly PhaseStepper.Phase[] _phases =
    {
        new("Connect", "done"), new("Authenticate", "done"), new("Schema", "done"),
        new("Read+write", "failed"), new("Upload", ""),
    };

    private sealed record Alert(string Rule, string Icon, string Kind, string[] Channels);
    private readonly Alert[] _alerts =
    {
        new("Critical failure", "alert-triangle", "danger", new[] { "mail", "brand-slack" }),
        new("Excessive retries", "refresh-alert", "warn", new[] { "brand-slack" }),
        new("Schedule did not complete", "calendar-x", "warn", new[] { "mail" }),
    };

    protected override async Task OnInitializedAsync()
    {
        // GET /api/jobs/{id} — falls back to the demo content above when unreachable or unknown.
        _job = await Api.TryGetJobAsync(EffectiveId);
    }

    private async Task RetryAsync()
    {
        if (_job is null)
        {
            Nav.NavigateTo("jobs/7c4a01f3");
            return;
        }

        // POST /api/reports/{name}/run — "resume from checkpoint" stays disabled above: v1 has
        // no checkpoint store (D2/D19 no-op), so only a from-scratch rerun is a real capability.
        var jobId = await Api.TryRunReportAsync(_job.ReportName);
        if (jobId is not null)
            Nav.NavigateTo($"jobs/{jobId}");
    }

    private static string FormatSpan(TimeSpan span) => span.TotalHours >= 1
        ? $"{(int)span.TotalHours}h {span.Minutes}m"
        : $"{span.Minutes}m {span.Seconds}s";
}
