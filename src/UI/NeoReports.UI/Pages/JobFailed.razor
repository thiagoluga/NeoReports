@page "/jobs/failed"
@page "/jobs/failed/{Id}"
@using NeoReports.UI.Components.UI
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

@if (_loading)
{
    <div class="page"><PageLoading /></div>
    return;
}
@if (_job is null)
{
    <div class="page">
        <EmptyState Icon="report-off" Title="Job not found">
            <ChildContent>
                @(string.IsNullOrEmpty(Id) ? "No job id given." : $"No job matches \"{Id}\", or the engine API is unreachable.")
            </ChildContent>
            <Action><Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Back to reports</Button></Action>
        </EmptyState>
    </div>
    return;
}

<div class="page">
    <div class="page-head">
        <div class="title">
            <div style="display:flex;align-items:center;gap:12px">
                <h1 style="font-size:24px">@_job.ReportName</h1>
                <Badge Variant="danger" Icon="alert-triangle">Failed</Badge>
            </div>
            <div class="sub mono" style="margin-top:6px">job_@Id · @_job.ReportName · ended @(_job.CompletedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</div>
        </div>
        <div style="display:flex;gap:8px">
            <Button Variant="outline" Icon="refresh" OnClick="RetryAsync">Retry</Button>
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>

    <div class="hero-status danger">
        <div class="badge-ico"><i class="ti ti-alert-triangle"></i></div>
        <div>
            <div class="title">Job failed</div>
            <div class="sub">@(_job.Error ?? "—")</div>
            <div class="sub mono" style="margin-top:4px">failed after @DurationText · @(_job.Stats.Retries) retries recorded</div>
        </div>
    </div>

    <Card Flat="true" Dense="true"><PhaseStepper Phases="_phases" /></Card>

    <div class="grid-4">
        <MetricCard Icon="download" Label="Read" Value="@(_job.Stats.RecordsRead.ToString("N0"))" Sub="partial" />
        <MetricCard Icon="upload" Label="Written" Value="@(_job.Stats.RecordsWritten.ToString("N0"))" Sub="partial" />
        <MetricCard Icon="clock" Label="Duration" Value="@DurationText" Sub="aborted before upload" />
        <MetricCard Icon="refresh" Label="Retries" Value="@(_job.Stats.Retries.ToString())" Sub="exhausted · no recovery" />
    </div>

    <Card Title="What to do now?" Sub="Three paths · ordered least to most destructive">
        <div>
            <div class="option-row">
                <span class="opt-icon"><i class="ti ti-bookmark"></i></span>
                <div>
                    <div class="opt-title-row"><span class="opt-title">Resume from checkpoint</span></div>
                    <div class="opt-desc">Not available in this version — v1 has no checkpoint store yet.</div>
                </div>
                <Button Variant="primary" Icon="player-play" Disabled="true">Resume</Button>
            </div>
            <div class="option-row">
                <span class="opt-icon"><i class="ti ti-rotate"></i></span>
                <div><div class="opt-title-row"><span class="opt-title">Run from scratch</span></div><div class="opt-desc">Discards the checkpoint and reruns everything. Slower, but safe if the source data changed.</div></div>
                <Button Variant="outline" Icon="player-play" OnClick="RetryAsync">Run</Button>
            </div>
            <div class="option-row">
                <span class="opt-icon"><i class="ti ti-pencil"></i></span>
                <div><div class="opt-title-row"><span class="opt-title">Edit configuration and retry</span></div><div class="opt-desc">Adjust threshold, retry policy or query before rerunning. Useful if the error is systematic.</div></div>
                <Button Variant="outline" Icon="pencil" OnClick="@(() => Nav.NavigateTo("builder"))">Edit</Button>
            </div>
        </div>
    </Card>

    <Card Title="Stack trace" Sub="first and last line highlighted">
        @if (_job.Error is { } error)
        {
            <pre class="stack"><span class="err">@error</span></pre>
        }
        else
        {
            <span class="muted" style="font-size:12px">No error detail recorded for this job.</span>
        }
    </Card>

    @* Timeline + Retries — GET /api/jobs/{id}/events (ADR D38); [] when no event store is
       registered on the host, same wire shape as "no events yet" — one honest state either way. *@
    <Card Title="Timeline" Sub="@(_events.Count == 0 ? "—" : $"{_events.Count} event(s)")">
        @if (_events.Count == 0)
        {
            <span class="muted" style="font-size:12px">No events recorded — the event log may not be enabled on this host.</span>
        }
        else
        {
            <Timeline Rows="@_events.Select(JobEventFormatter.ToTimelineRow).ToArray()" />
        }
    </Card>

    <Card Title="Retries this job" Sub="@(_retryEvents.Count == 0 ? "—" : $"{_retryEvents.Count} retry(ies)")">
        @if (_retryEvents.Count == 0)
        {
            <span class="muted" style="font-size:12px">No retries so far.</span>
        }
        else
        {
            <Timeline Rows="@_retryEvents.Select(JobEventFormatter.ToTimelineRow).ToArray()" Expanded="true" />
        }
    </Card>

    @* Partial output — GET /api/jobs/{id}/partial-artifacts (ADR D40). Best-effort output staged
       before the run stopped; never at the report's real configured destinations. The wire can't
       distinguish "no partial-artifact store registered on this host" from "registered, but
       nothing was captured" (both return []) — one honest empty state covers both, the same
       resolution used for the job event log (E3). *@
    <Card Title="Partial output" Sub="@(_partials.Count == 0 ? "—" : $"{_partials.Count} file(s)")">
        @if (_partials.Count == 0)
        {
            <span class="muted" style="font-size:12px">No partial output was captured for this job.</span>
        }
        else
        {
            <Banner Variant="warn" Icon="alert-triangle">
                <b>Best-effort output</b>
                <span style="font-size:12px">Written before the run stopped — incomplete and unverified. Never delivered to the report's real destinations.</span>
            </Banner>
            <div>
                @foreach (var a in _partials)
                {
                    <div class="file-row">
                        <CatTile Sm="true" Kind="warn" Icon="@FileFormatting.Icon(a.FileName)" />
                        <div class="file-name"><b>@a.FileName</b><span>@FileFormatting.Bytes(a.SizeBytes) · @a.MimeType</span></div>
                        <div class="file-actions"><Button Variant="outline" Size="sm" Icon="download" OnClick="DownloadPartial">Download</Button></div>
                    </div>
                }
            </div>
        }
    </Card>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private bool _loading;
    private ApiJobView? _job;
    private IReadOnlyList<ApiJobEvent> _events = Array.Empty<ApiJobEvent>();
    private IReadOnlyList<ApiJobEvent> _retryEvents = Array.Empty<ApiJobEvent>();
    private IReadOnlyList<ApiArtifact> _partials = Array.Empty<ApiArtifact>();

    private TimeSpan? Duration => _job?.StartedAt is { } s && _job.CompletedAt is { } c ? c - s : null;
    private string DurationText => Duration is { } d ? FormatSpan(d) : "—";

    private readonly PhaseStepper.Phase[] _phases =
    {
        new("Connect", "done"), new("Authenticate", "done"), new("Schema", "done"),
        new("Read+write", "failed"), new("Upload", ""),
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Id))
            return;

        _loading = true;
        try
        {
            _job = await Api.TryGetJobAsync(Id);
        }
        finally
        {
            _loading = false;
        }
        if (_job is not null)
        {
            var events = await Api.TryGetJobEventsAsync(Id);
            if (events is not null)
            {
                _events = events;
                _retryEvents = events.Where(e => e.Type == "retry").ToArray();
            }

            _partials = await Api.TryGetPartialArtifactsAsync(Id) ?? Array.Empty<ApiArtifact>();
        }
    }

    private void DownloadPartial()
    {
        if (Id is not null)
            Nav.NavigateTo(Api.BuildPartialDownloadUrl(Id), forceLoad: true);
    }

    private async Task RetryAsync()
    {
        if (_job is null)
            return;

        // POST /api/reports/{name}/run — "resume from checkpoint" stays disabled above: v1 has
        // no checkpoint store (D2/D19 no-op), so only a from-scratch rerun is a real capability.
        var jobId = await Api.TryRunReportAsync(_job.ReportName);
        if (jobId is not null)
            Nav.NavigateTo($"jobs/{jobId}");
    }

    private static string FormatSpan(TimeSpan span) => span.TotalHours >= 1
        ? $"{(int)span.TotalHours}h {span.Minutes}m"
        : $"{span.Minutes}m {span.Seconds}s";
}
