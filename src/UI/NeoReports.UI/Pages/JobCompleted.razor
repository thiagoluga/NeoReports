@page "/jobs/completed"
@page "/jobs/completed/{Id}"
@using NeoReports.UI.Components.UI
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

@if (_job is null)
{
    <div class="page">
        <EmptyState Icon="report-off" Title="Job not found">
            <ChildContent>
                @(string.IsNullOrEmpty(Id) ? "No job id given." : $"No job matches \"{Id}\", or the engine API is unreachable.")
            </ChildContent>
            <Action><Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Back to reports</Button></Action>
        </EmptyState>
    </div>
    return;
}

<div class="page">
    <div class="page-head">
        <div class="title">
            <div style="display:flex;align-items:center;gap:12px">
                <h1 style="font-size:24px">@_job.ReportName</h1>
                <Badge Variant="success" Icon="check">Completed</Badge>
            </div>
            <div class="sub mono" style="margin-top:6px">job_@Id · @_job.ReportName · finished @(_job.CompletedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</div>
        </div>
        <div style="display:flex;gap:8px">
            <Button Variant="outline" Icon="link">Copy link</Button>
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>

    <div class="hero-status success">
        <div class="badge-ico"><i class="ti ti-check"></i></div>
        <div>
            <div class="title">Report generated successfully</div>
            <div class="sub">@SummaryText</div>
        </div>
        <Button Variant="danger" Icon="trash"></Button>
    </div>

    <Card Flat="true" Dense="true"><PhaseStepper Phases="_phases" /></Card>

    <div class="grid-4">
        <MetricCard Icon="download" Label="Read" Value="@(_job.Stats.RecordsRead.ToString("N0"))" Sub="records" />
        <MetricCard Icon="upload" Label="Written" Value="@(_job.Stats.RecordsWritten.ToString("N0"))" Sub="records" />
        <MetricCard Icon="clock" Label="Duration" Value="@DurationText" />
        <MetricCard Icon="refresh" Label="Retries" Value="@(_job.Stats.Retries.ToString())" />
    </div>

    @* Files — GET /api/jobs/{id}/artifacts (Epic D / D8); GET /api/jobs/{id}/download *@
    <Card Title="Generated files" Sub="Final snapshot · available for 7 days">
        <div>
        @if (_artifacts is null || _artifacts.Count == 0)
        {
            <EmptyState Icon="file-off" Title="No files recorded for this job" />
        }
        else
        {
            @foreach (var a in _artifacts)
            {
                <div class="file-row">
                    <CatTile Sm="true" Kind="teal" Icon="@FileFormatting.Icon(a.FileName)" />
                    <div class="file-name"><b>@a.FileName</b><span>@FileFormatting.Bytes(a.SizeBytes) · @a.MimeType</span></div>
                    <div class="file-actions"><Button Variant="primary" Size="sm" Icon="download" OnClick="Download">Download</Button></div>
                </div>
            }
        }
        </div>
    </Card>

    @* Destinations — real destination types from GET /api/reports/{name} once resolved; no
       per-destination delivery confirmation exists, so this only lists what's configured. *@
    <Card>
        <TitleContent>Destinations</TitleContent>
        <SubContent>
        @if (_reportDetail is not null)
        {
            <span class="mono muted" style="font-size:12px">@_reportDetail.Destinations.Count configured</span>
        }
        </SubContent>
        <ChildContent>
        <div>
        @if (_reportDetail is null)
        {
            <span class="muted" style="font-size:12px">—</span>
        }
        else if (_reportDetail.Destinations.Count == 0)
        {
            <span class="muted" style="font-size:12px">No destinations configured</span>
        }
        else
        {
            @foreach (var d in _reportDetail.Destinations)
            {
                <div class="dest-row">
                    <CatTile Sm="true" Kind="info" Icon="cloud-upload" />
                    <div><div class="d-name">@d</div></div>
                </div>
            }
        }
        </div>
        </ChildContent>
    </Card>

    @* Configuration — Report/Formats/Buffer/Retry policy real once GET /api/reports/{name}
       resolves. "Worker" and "Run by" are dropped rather than replaced: v1 is single-worker
       (no worker-pool concept) and jobs carry no "triggered by" identity. *@
    <Card Title="Configuration" Sub="Snapshot of what ran">
        <div class="kv">
            <span class="k">Report</span><span class="v mono">@_job.ReportName</span>
            <span class="k">Formats</span><span class="v">@FormatsText</span>
            <span class="k">Buffer</span><span class="v mono">@BufferText</span>
            <span class="k">Retry policy</span><span class="v mono">@RetryPolicyText</span>
        </div>
    </Card>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private ApiJobView? _job;
    private ApiReportDetail? _reportDetail;
    private IReadOnlyList<ApiArtifact>? _artifacts;

    private string SummaryText => $"{_job!.Stats.RecordsWritten:N0} rows processed{DurationSuffix}";
    private string DurationSuffix => Duration is { } d ? $" in {FormatSpan(d)}" : "";
    private TimeSpan? Duration => _job?.StartedAt is { } s && _job.CompletedAt is { } c ? c - s : null;
    private string DurationText => Duration is { } d ? FormatSpan(d) : "—";

    // Configuration card — real once GET /api/reports/{name} resolves for the job's report.
    private string FormatsText => _reportDetail is not null
        ? string.Join(", ", _reportDetail.Formats.Select(f => f.ToUpperInvariant()))
        : "—";
    private string BufferText => _reportDetail is not null
        ? $"{_reportDetail.PageSize:N0} rows/page"
        : "—";
    private string RetryPolicyText => _reportDetail is not null
        ? ResilienceFormatter.Format(_reportDetail)
        : "—";

    private readonly PhaseStepper.Phase[] _phases =
    {
        new("Connect", "done"), new("Authenticate", "done"), new("Schema", "done"),
        new("Read+write", "done"), new("Upload", "done"),
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Id))
            return;

        _job = await Api.TryGetJobAsync(Id);
        if (_job is not null)
        {
            _artifacts = await Api.TryGetJobArtifactsAsync(Id);
            _reportDetail = await Api.TryGetReportDetailAsync(_job.ReportName);
        }
    }

    private void Download()
    {
        if (_job is not null)
            Nav.NavigateTo(Api.BuildDownloadUrl(Id!), forceLoad: true);
    }

    private static string FormatSpan(TimeSpan span) => span.TotalHours >= 1
        ? $"{(int)span.TotalHours}h {span.Minutes}m"
        : $"{span.Minutes}m {span.Seconds}s";
}
