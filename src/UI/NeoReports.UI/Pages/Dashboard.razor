@page "/"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

<div class="page">
    <div class="page-head">
        <div class="title">
            <h1>Dashboard</h1>
            <div class="sub">Overview of the last 24 hours</div>
        </div>
        <Button Variant="primary" Icon="plus" OnClick="@(() => Nav.NavigateTo("builder"))">New report</Button>
    </div>

    @* Metric strip — GET /api/jobs, computed client-side; "—" placeholders when the engine
       is unreachable, since the engine doesn't expose aggregate metrics directly. *@
    <div class="grid-4">
        <MetricCard Icon="report-analytics" Label="Jobs today" Value="@_metrics.JobsToday" Sub="since 00:00 UTC" />
        <MetricCard Icon="circle-check" Label="Success rate" Value="@_metrics.SuccessRate" Sub="today · terminal jobs" />
        <MetricCard Icon="file-text" Label="Records exported" Value="@_metrics.RecordsExported" Sub="today" />
        <MetricCard Icon="clock" Label="Avg duration" Value="@_metrics.AvgDuration" Sub="today · completed" />
    </div>

    @* Recent jobs — GET /api/jobs (limit 8) *@
    <Card Title="Recent jobs" Sub="Newest first">
        <Action><Button Variant="link" OnClick="@(() => Nav.NavigateTo("jobs"))">View all →</Button></Action>
        <ChildContent>
        @if (!_isLive)
        {
            <EmptyState Icon="report-off" Title="Engine unreachable">
                <ChildContent>Recent jobs will show up here once the engine API is reachable.</ChildContent>
            </EmptyState>
        }
        else if (_recentJobs.Count == 0)
        {
            <EmptyState Icon="report-off" Title="No recent jobs">
                <ChildContent>Trigger a report from the builder or the reports list to see it here.</ChildContent>
            </EmptyState>
        }
        else
        {
        <DataGrid Columns="5" Empty="false">
            <Head>
                <tr>
                    <th>Report</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Started</th>
                    <th>Duration</th>
                </tr>
            </Head>
            <Body>
                @foreach (var r in _recentJobs)
                {
                    <tr class="clickable" @onclick="@(() => Nav.NavigateTo(r.Route))">
                        <td>
                            <div style="display:flex;align-items:center;gap:10px">
                                <CatTile Kind="gray" Icon="report" Sm="true" />
                                <div>
                                    <div style="font-weight:500">@r.ReportName</div>
                                    <div class="mono muted" style="font-size:11px">—</div>
                                </div>
                            </div>
                        </td>
                        <td><JobStatusBadge Status="r.Status" LabelOverride="@r.StatusLabel" /></td>
                        <td><span class="muted" style="font-size:12px">@r.ProgressLabel</span></td>
                        <td class="mono">@r.Started</td>
                        <td class="mono">@r.Duration</td>
                    </tr>
                }
            </Body>
        </DataGrid>
        }
        </ChildContent>
    </Card>

    @* Recent files — real filenames/sizes from the completed jobs above, via
       GET /api/jobs/{id}/artifacts (Epic D / D6, follow-up). The fake "Destinations" upload list
       was removed — no per-destination delivery confirmation exists in the engine (D36); see
       docs/ui-removed-mock-content.md. *@
    <div class="grid-2">
        <Card Title="Recent files" Sub="From completed jobs">
            <Action><Button Variant="link" OnClick="@(() => Nav.NavigateTo("reports"))">View reports →</Button></Action>
            <ChildContent>
            @if (!_isLive)
            {
                <span class="muted" style="font-size:12px">Engine unreachable</span>
            }
            else if (_recentFiles.Count == 0)
            {
                <span class="muted" style="font-size:12px">No files generated yet</span>
            }
            else
            {
                @foreach (var f in _recentFiles)
                {
                    <div class="list-row">
                        <CatTile Kind="teal" Icon="@FileFormatting.Icon(f.FileName)" Sm="true" />
                        <div class="col" style="gap:0"><span class="name">@f.FileName</span><span class="sub">@f.ReportName · @FileFormatting.Bytes(f.SizeBytes)</span></div>
                        <span class="right">@(f.CompletedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</span>
                    </div>
                }
            }
            </ChildContent>
        </Card>

        @* Most referenced sources — GET /api/sources (ADR D42), ranked by the real
           ReferencedByCount. Hidden entirely on an empty registry (no source registered
           anywhere yet) rather than showing an empty card — consistent with D9's sources
           section rendering only when data exists. *@
        @if (_mostReferencedSources.Count > 0)
        {
            <Card Title="Most referenced sources" Sub="By registered report count">
                <Action><Button Variant="link" OnClick="@(() => Nav.NavigateTo("sources"))">View sources →</Button></Action>
                <ChildContent>
                @foreach (var s in _mostReferencedSources)
                {
                    <div class="list-row">
                        <CatTile Kind="teal" Icon="database" Sm="true" />
                        <div class="col" style="gap:0"><span class="name mono">@s.Name</span><span class="sub">@s.Type</span></div>
                        <span class="right">@s.ReferencedByCount report(s)</span>
                    </div>
                }
                </ChildContent>
            </Card>
        }
    </div>
</div>

@code {
    private sealed record DashboardMetrics(string JobsToday, string SuccessRate, string RecordsExported, string AvgDuration)
    {
        public static readonly DashboardMetrics Unavailable = new("—", "—", "—", "—");
    }

    private sealed record DashboardFileRow(string ReportName, string FileName, long SizeBytes, DateTimeOffset? CompletedAt);

    private bool _isLive;
    private IReadOnlyList<JobRowFormatter.Row> _recentJobs = Array.Empty<JobRowFormatter.Row>();
    private DashboardMetrics _metrics = DashboardMetrics.Unavailable;
    private IReadOnlyList<DashboardFileRow> _recentFiles = Array.Empty<DashboardFileRow>();
    private IReadOnlyList<ApiSourceView> _mostReferencedSources = Array.Empty<ApiSourceView>();

    private static string FormatDuration(DateTimeOffset? started, DateTimeOffset? completed)
    {
        if (started is not { } s || completed is not { } c)
            return "—";

        TimeSpan span = c - s;
        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m {span.Seconds}s" : $"{span.Seconds}s";
    }

    protected override async Task OnInitializedAsync()
    {
        IReadOnlyList<ApiJobView>? recent = await Api.TryListJobsAsync(limit: 8);
        if (recent is null)
            return;

        _isLive = true;
        _recentJobs = recent.Select(JobRowFormatter.ToRow).ToArray();

        DateTimeOffset todayUtc = DateTimeOffset.UtcNow.Date;
        IReadOnlyList<ApiJobView>? todaysJobs = await Api.TryListJobsAsync(since: todayUtc, limit: 200);
        _metrics = ComputeMetrics(todaysJobs ?? recent);

        _recentFiles = await LoadRecentFilesAsync(recent);

        IReadOnlyList<ApiSourceView>? sources = await Api.TryListSourcesAsync();
        _mostReferencedSources = (sources ?? Array.Empty<ApiSourceView>())
            .Where(s => s.ReferencedByCount > 0)
            .OrderByDescending(s => s.ReferencedByCount)
            .ThenBy(s => s.Name, StringComparer.Ordinal)
            .Take(5)
            .ToArray();
    }

    // GET /api/jobs/{id}/artifacts for a handful of the most recently completed jobs — the job
    // list itself carries no file info, so this is the only way to show real generated files.
    private async Task<IReadOnlyList<DashboardFileRow>> LoadRecentFilesAsync(IReadOnlyList<ApiJobView> recent)
    {
        var files = new List<DashboardFileRow>();
        foreach (var job in recent.Where(j => j.Status == "Completed").Take(3))
        {
            var artifacts = await Api.TryGetJobArtifactsAsync(job.Id);
            if (artifacts is null)
                continue;

            files.AddRange(artifacts.Select(a => new DashboardFileRow(job.ReportName, a.FileName, a.SizeBytes, job.CompletedAt)));
        }

        return files.OrderByDescending(f => f.CompletedAt).Take(5).ToArray();
    }

    private static DashboardMetrics ComputeMetrics(IReadOnlyList<ApiJobView> jobs)
    {
        var terminal = jobs.Where(j => j.Status is "Completed" or "Failed" or "Cancelled").ToArray();
        var completed = jobs.Where(j => j.Status == "Completed").ToArray();

        string successRate = terminal.Length > 0
            ? $"{100.0 * completed.Length / terminal.Length:0.0}%"
            : "—";

        long recordsWritten = completed.Sum(j => j.Stats.RecordsWritten);

        var durations = completed
            .Where(j => j.StartedAt is not null && j.CompletedAt is not null)
            .Select(j => j.CompletedAt!.Value - j.StartedAt!.Value)
            .ToArray();
        string avgDuration = durations.Length > 0
            ? FormatDuration(DateTimeOffset.UnixEpoch, DateTimeOffset.UnixEpoch + TimeSpan.FromTicks((long)durations.Average(d => d.Ticks)))
            : "—";

        return new DashboardMetrics(jobs.Count.ToString(), successRate, recordsWritten.ToString("N0"), avgDuration);
    }
}
