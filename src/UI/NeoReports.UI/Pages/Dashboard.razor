@page "/"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

<div class="page">
    <div class="page-head">
        <div class="title">
            <h1>Dashboard</h1>
            <div class="sub">Overview of the last 24 hours</div>
        </div>
        <Button Variant="primary" Icon="plus" OnClick="@(() => Nav.NavigateTo("builder"))">New report</Button>
    </div>

    @* Metric strip — real when the engine is reachable (GET /api/jobs, computed client-side);
       demo values otherwise, since the engine doesn't expose aggregate metrics directly. *@
    <div class="grid-4">
        <MetricCard Icon="report-analytics" Label="Jobs today" Value="@_metrics.JobsToday" Sub="@(_isLive ? "since 00:00 UTC" : "vs yesterday")" DeltaDir="@(_isLive ? null : "up")" DeltaText="@(_isLive ? null : "+3.4%")" />
        <MetricCard Icon="circle-check" Label="Success rate" Value="@_metrics.SuccessRate" Sub="@(_isLive ? "today · terminal jobs" : "last 7 days")" />
        <MetricCard Icon="file-text" Label="Records exported" Value="@_metrics.RecordsExported" Sub="@(_isLive ? "today" : "last 7 days")" />
        <MetricCard Icon="clock" Label="Avg duration" Value="@_metrics.AvgDuration" Sub="@(_isLive ? "today · completed" : "vs week")" DeltaDir="@(_isLive ? null : "down")" DeltaText="@(_isLive ? null : "-18s")" />
    </div>

    @* Recent jobs — GET /api/jobs (limit 8), falling back to sample report templates *@
    <Card Title="Recent jobs" Sub="@(_isLive ? "Newest first" : "Last 24 hours")">
        <Action>
            <Button Variant="link" OnClick="@(() => Nav.NavigateTo(_isLive && _recentJobs.Count > 0 ? JobRoute(_recentJobs[0]) : "jobs/7c4a01f3"))">View all →</Button>
        </Action>
        <ChildContent>
        @if (_recentJobs.Count == 0)
        {
            <EmptyState Icon="report-off" Title="No recent jobs">
                <ChildContent>Trigger a report from the builder or the reports list to see it here.</ChildContent>
            </EmptyState>
        }
        else
        {
        <DataGrid Columns="5" Empty="false">
            <Head>
                <tr>
                    <th>Report</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Started</th>
                    <th>Duration</th>
                </tr>
            </Head>
            <Body>
                @foreach (var r in _recentJobs)
                {
                    <tr class="clickable" @onclick="@(() => Nav.NavigateTo(JobRoute(r)))">
                        <td>
                            <div style="display:flex;align-items:center;gap:10px">
                                <CatTile Kind="@r.CatKind" Icon="@r.CatIcon" Sm="true" />
                                <div>
                                    <div style="font-weight:500">@r.Name</div>
                                    <div class="mono muted" style="font-size:11px">@r.SourceLabel</div>
                                </div>
                            </div>
                        </td>
                        <td><JobStatusBadge Status="r.Status" LabelOverride="@(r.Status == JobStatus.Ok ? "Completed" : null)" /></td>
                        <td><span class="muted" style="font-size:12px">@r.ProgressLabel</span></td>
                        <td class="mono">@r.Started</td>
                        <td class="mono">@r.Duration</td>
                    </tr>
                }
            </Body>
        </DataGrid>
        }
        </ChildContent>
    </Card>

    @* Destinations → Recent files when live: real filenames/sizes from the completed jobs
       above, via GET /api/jobs/{id}/artifacts (Epic D / D6, follow-up). The "Sources" card
       (usage-frequency ranking) was removed — no source registry or usage tracking exists in
       the engine (D36); see docs/ui-removed-mock-content.md. *@
    <div>
        <Card Title="@(_isLive ? "Recent files" : "Destinations")" Sub="@(_isLive ? "From completed jobs" : "Latest uploads")">
            <Action><Button Variant="link" OnClick="@(() => Nav.NavigateTo("reports"))">@(_isLive ? "View reports →" : "Manage →")</Button></Action>
            <ChildContent>
            @if (_isLive)
            {
                @if (_recentFiles.Count == 0)
                {
                    <span class="muted" style="font-size:12px">No files generated yet</span>
                }
                else
                {
                    @foreach (var f in _recentFiles)
                    {
                        <div class="list-row">
                            <CatTile Kind="teal" Icon="@FileFormatting.Icon(f.FileName)" Sm="true" />
                            <div class="col" style="gap:0"><span class="name">@f.FileName</span><span class="sub">@f.ReportName · @FileFormatting.Bytes(f.SizeBytes)</span></div>
                            <span class="right">@(f.CompletedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</span>
                        </div>
                    }
                }
            }
            else
            {
                <div class="list-row">
                    <CatTile Kind="info" Icon="cloud-upload" Sm="true" />
                    <div class="col" style="gap:0"><span class="name">SharePoint · /Sales/2026</span><span class="sub">last upload</span></div>
                    <span class="right">14:35:54</span>
                </div>
                <div class="list-row">
                    <CatTile Kind="info" Icon="brand-aws" Sm="true" />
                    <div class="col" style="gap:0"><span class="name">s3://acme-reports/billing</span><span class="sub">last upload</span></div>
                    <span class="right">14:18:02</span>
                </div>
                <div class="list-row">
                    <CatTile Kind="warn" Icon="mail" Sm="true" />
                    <div class="col" style="gap:0"><span class="name">email · ana@@acme.com</span><span class="sub">last upload</span></div>
                    <span class="right">12:02:11</span>
                </div>
            }
            </ChildContent>
        </Card>
    </div>
</div>

@code {
    private sealed record DashboardJobRow(
        string Id, string Name, string CatKind, string CatIcon, string SourceLabel,
        JobStatus Status, string ProgressLabel, string Started, string Duration);

    private sealed record DashboardMetrics(string JobsToday, string SuccessRate, string RecordsExported, string AvgDuration)
    {
        public static readonly DashboardMetrics Demo = new("486", "98.4%", "—", "3m 12s");
    }

    private sealed record DashboardFileRow(string ReportName, string FileName, long SizeBytes, DateTimeOffset? CompletedAt);

    private bool _isLive;
    private IReadOnlyList<DashboardJobRow> _recentJobs = SampleData.Reports
        .Select(ToRow)
        .ToArray();
    private DashboardMetrics _metrics = DashboardMetrics.Demo;
    private IReadOnlyList<DashboardFileRow> _recentFiles = Array.Empty<DashboardFileRow>();

    private static string JobRoute(DashboardJobRow r) => r.Status switch
    {
        JobStatus.Failed => $"jobs/failed/{r.Id}",
        JobStatus.Ok => $"jobs/completed/{r.Id}",
        _ => $"jobs/{r.Id}",
    };

    private static DashboardJobRow ToRow(ReportSummary r) => new(
        Id: r.Status == JobStatus.Failed ? "8b2f01a9" : "7c4a01f3",
        Name: r.Name,
        CatKind: r.CatKind,
        CatIcon: r.CatIcon,
        SourceLabel: $"{r.Source} → {string.Join(" + ", r.Formats)}",
        Status: r.Status,
        ProgressLabel: r.Status switch
        {
            JobStatus.Running => "64%",
            JobStatus.Failed => "15/15 retries",
            JobStatus.Paused => "waiting",
            _ => "Completed",
        },
        Started: r.LastTitle,
        Duration: DurationOf(r));

    private static DashboardJobRow ToRow(ApiJobView j) => new(
        Id: j.Id,
        Name: j.ReportName,
        CatKind: "gray",
        CatIcon: "report",
        SourceLabel: "—",
        Status: ToJobStatus(j.Status),
        ProgressLabel: j.Status,
        Started: j.StartedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—",
        Duration: FormatDuration(j.StartedAt, j.CompletedAt));

    private static JobStatus ToJobStatus(string status) => status switch
    {
        "Completed" => JobStatus.Ok,
        "Failed" => JobStatus.Failed,
        "Running" or "Retrying" => JobStatus.Running,
        "Paused" => JobStatus.Paused,
        _ => JobStatus.Queued,
    };

    private static string FormatDuration(DateTimeOffset? started, DateTimeOffset? completed)
    {
        if (started is not { } s || completed is not { } c)
            return "—";

        TimeSpan span = c - s;
        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m {span.Seconds}s" : $"{span.Seconds}s";
    }

    private static string DurationOf(ReportSummary r)
    {
        if (r.Status == JobStatus.Paused) return "—";
        var parts = r.LastSub.Split('·');
        return parts.Length > 1 ? parts[1].Trim() : "—";
    }

    protected override async Task OnInitializedAsync()
    {
        IReadOnlyList<ApiJobView>? recent = await Api.TryListJobsAsync(limit: 8);
        if (recent is null)
            return;

        _isLive = true;
        _recentJobs = recent.Select(ToRow).ToArray();

        DateTimeOffset todayUtc = DateTimeOffset.UtcNow.Date;
        IReadOnlyList<ApiJobView>? todaysJobs = await Api.TryListJobsAsync(since: todayUtc, limit: 200);
        _metrics = ComputeMetrics(todaysJobs ?? recent);

        _recentFiles = await LoadRecentFilesAsync(recent);
    }

    // GET /api/jobs/{id}/artifacts for a handful of the most recently completed jobs — the job
    // list itself carries no file info, so this is the only way to show real generated files.
    private async Task<IReadOnlyList<DashboardFileRow>> LoadRecentFilesAsync(IReadOnlyList<ApiJobView> recent)
    {
        var files = new List<DashboardFileRow>();
        foreach (var job in recent.Where(j => j.Status == "Completed").Take(3))
        {
            var artifacts = await Api.TryGetJobArtifactsAsync(job.Id);
            if (artifacts is null)
                continue;

            files.AddRange(artifacts.Select(a => new DashboardFileRow(job.ReportName, a.FileName, a.SizeBytes, job.CompletedAt)));
        }

        return files.OrderByDescending(f => f.CompletedAt).Take(5).ToArray();
    }

    private static DashboardMetrics ComputeMetrics(IReadOnlyList<ApiJobView> jobs)
    {
        var terminal = jobs.Where(j => j.Status is "Completed" or "Failed" or "Cancelled").ToArray();
        var completed = jobs.Where(j => j.Status == "Completed").ToArray();

        string successRate = terminal.Length > 0
            ? $"{100.0 * completed.Length / terminal.Length:0.0}%"
            : "—";

        long recordsWritten = completed.Sum(j => j.Stats.RecordsWritten);

        var durations = completed
            .Where(j => j.StartedAt is not null && j.CompletedAt is not null)
            .Select(j => j.CompletedAt!.Value - j.StartedAt!.Value)
            .ToArray();
        string avgDuration = durations.Length > 0
            ? FormatDuration(DateTimeOffset.UnixEpoch, DateTimeOffset.UnixEpoch + TimeSpan.FromTicks((long)durations.Average(d => d.Ticks)))
            : "—";

        return new DashboardMetrics(jobs.Count.ToString(), successRate, recordsWritten.ToString("N0"), avgDuration);
    }
}
