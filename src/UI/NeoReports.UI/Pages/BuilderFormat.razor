@page "/builder/format"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject BuilderState Wizard
@inject INeoReportsApiClient Api

<div class="page">
    <WizardStepper Steps="Steps" Current="2" />

    <div class="page-head">
        <div class="title">
            <h1>Choose formats</h1>
            <div class="sub">You can select more than one · step 3 of 5</div>
        </div>
    </div>

    @* Available formats — GET /api/capabilities (Epic D / D36 follow-up). Previously a fixed
       6-option catalog (CSV/XLSX/PDF/JSON/TXT/XML) regardless of what the engine actually has
       registered; v1 only ships CSV and XLSX writers, so PDF/JSON/TXT/XML were always dead ends.
       Per-format configuration (delimiter/encoding, sheet name/auto-filter, etc.) was removed:
       none of it was ever sent to the engine — OutputConfig only carries the format id. *@
    @if (Wizard.IsEditing && Wizard.AdditionalOutputCount > 0)
    {
        <Banner Variant="info" Icon="info-circle">
            <b>@(Wizard.AdditionalOutputCount) further output@(Wizard.AdditionalOutputCount == 1 ? "" : "s") on this report.</b>
            <span style="font-size:12px">It declares more than one output of the same format, each with its own writer options. These checkboxes select formats, so all outputs of a selected format are kept exactly as they are; clearing a format removes every output of it.</span>
        </Banner>
    }
    @if (!Wizard.EngineAvailable)
    {
        <Banner Variant="info" Icon="info-circle">
            <span style="font-size:12px">No engine capabilities were found in step 1 — nothing to select here yet.</span>
        </Banner>
    }
    else if (_engineFormats.Count == 0)
    {
        <EmptyState Icon="file-off" Title="No output formats registered">
            <ChildContent>The engine has no <span class="mono">IWriterFactory</span> registered.</ChildContent>
        </EmptyState>
    }
    else
    {
        <div>
            <p class="label-sm" style="margin-bottom:10px">Available formats</p>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
                @foreach (var f in _engineFormats.Select(ToFormatOption))
                {
                    <FormatCard Format="f" Selected="Wizard.Formats.Contains(f.Id)" OnClick="@(() => Toggle(f.Id))" />
                }
            </div>
        </div>
    }

    <div class="wizard-footer">
        <Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("builder/configure"))">Back</Button>
        <div style="display:flex;align-items:center;gap:12px">
            <span class="mono muted" style="font-size:12px">@Wizard.Formats.Count format@(Wizard.Formats.Count == 1 ? "" : "s") selected</span>
            <Button Variant="primary" IconRight="arrow-right" OnClick="@(() => Nav.NavigateTo("builder/destination"))">Continue</Button>
        </div>
    </div>
</div>

@code {
    private readonly string[] Steps = { "Source", "Columns", "Format", "Destination", "Review" };
    private IReadOnlyList<string> _engineFormats = Array.Empty<string>();

    private static readonly Dictionary<string, (string Name, string Ext, string Kind, string Icon, string Description)> KnownFormats = new()
    {
        ["csv"] = ("CSV", ".csv", "teal", "table", "Delimited tabular text."),
        ["xlsx"] = ("Excel", ".xlsx", "teal", "file-spreadsheet", "Spreadsheet with native types, sheets, formulas."),
    };

    private static FormatOption ToFormatOption(string id) =>
        KnownFormats.TryGetValue(id, out var known)
            ? new FormatOption(id, known.Name, known.Ext, known.Kind, known.Icon, known.Description)
            : new FormatOption(id, id.ToUpperInvariant(), $".{id}", "gray", "file", "Registered output format.");

    private void Toggle(string id) { if (!Wizard.Formats.Add(id)) Wizard.Formats.Remove(id); }

    protected override async Task OnInitializedAsync()
    {
        if (!Wizard.EngineAvailable)
            return;

        ApiCapabilities? capabilities = await Api.TryGetCapabilitiesAsync();
        _engineFormats = capabilities?.Formats ?? Array.Empty<string>();
    }
}
