@page "/reports/{Slug}"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

@if (_loading)
{
    <div class="page"><PageLoading /></div>
    return;
}
@if (_detail is null)
{
    <div class="page">
        <EmptyState Icon="report-off" Title="Report not found">
            <ChildContent>
                No report matches "@Slug", or the engine API is unreachable.
            </ChildContent>
            <Action><Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Back to reports</Button></Action>
        </EmptyState>
    </div>
    return;
}

<div class="page">
    @* Header — GET /api/reports/{name} *@
    <div class="page-head">
        <div class="title" style="max-width:720px">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <h1 style="font-size:24px">@_detail.Name</h1>
                <Chip Kind="token">origin: @_detail.Origin</Chip>
                @if (!string.IsNullOrEmpty(_detail.SourceRef))
                {
                    <Chip Kind="token">source: @_detail.SourceRef</Chip>
                }
            </div>
            <p class="sub" style="max-width:480px;margin-top:8px;line-height:1.5">@Description</p>
        </div>
        <div style="display:flex;gap:8px;align-self:flex-start;margin-top:6px">
            @* Only offered for dynamic (config-origin) reports — code-registered ones can't be
               deleted either, so there's no way to replace them (no PUT /api/reports/{name}). *@
            @if (_detail.Deletable)
            {
                <Button Variant="outline" Icon="pencil" OnClick="@(() => Nav.NavigateTo($"builder?edit={Uri.EscapeDataString(_detail.Name)}"))">Edit</Button>
            }
            <Button Variant="outline" Icon="eye" OnClick="@(() => Nav.NavigateTo($"reports/{_detail.Name}/preview"))">Preview</Button>
            <Button Variant="primary" Icon="player-play" OnClick="RunNowAsync">Run now</Button>
            @if (_detail.Deletable)
            {
                <Button Variant="danger" Icon="trash" Loading="_deleting" OnClick="DeleteAsync">
                    @(_confirmingDelete ? "Confirm delete" : "Delete report")
                </Button>
            }
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>
    @if (_deleteError is not null)
    {
        <Banner Variant="danger" Icon="alert-triangle">
            <b>Could not delete the report</b>
            <span style="font-size:12px">@_deleteError</span>
        </Banner>
    }

    @* Metric strip — Total runs/Success rate/Avg duration computed from GET /api/jobs.
       "Next run" reflects the real effective schedule (ADR D41), never fabricated. *@
    <div class="grid-4">
        <MetricCard Icon="player-play" Label="Total runs" Value="@_metrics.TotalRuns" Sub="known jobs" />
        <MetricCard Icon="circle-check" Label="Success rate" Value="@_metrics.SuccessRate" Sub="known jobs · terminal" />
        <MetricCard Icon="clock" Label="Avg duration" Value="@_metrics.AvgDuration" Sub="completed jobs" />
        <MetricCard Icon="calendar" Label="Next run"
            Value="@(_detail.NextRunAt is not null ? NextRunLocal : "Not scheduled")"
            Sub="@(_detail.NextRunAt is not null ? $"{NextRunUtc} UTC" : "trigger via API or the run button")" />
    </div>

    <div>
        @* Configuration *@
        <Card Title="Configuration" Sub="Current template snapshot">
            <Action><Button Variant="link">Change history →</Button></Action>
            <ChildContent>
            <div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-columns"></i>Columns</span>
                    <div class="val">
                        <span>@_detail.Columns.Count selected</span>
                        <span class="mono muted" style="font-size:11px">@string.Join(", ", _detail.Columns.Select(c => c.Name))</span>
                    </div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-file-text"></i>Formats</span>
                    <div class="val">
                        <div class="pipeline-chips" style="gap:4px">
                            @foreach (var f in _detail.Formats)
                            {
                                <Chip Kind="format" Ext="@f.ToLower()">@f</Chip>
                            }
                        </div>
                    </div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-cloud-upload"></i>Destinations</span>
                    <div class="val"><span>@Destinations</span></div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-stack-2"></i>Buffer</span>
                    <div class="val"><span class="mono" style="font-size:12px">@($"{_detail.PageSize:N0} rows/page")</span></div>
                    <span></span>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-shield-check"></i>Resilience</span>
                    <div class="val"><span class="mono" style="font-size:12px">@ResilienceFormatter.Format(_detail)</span></div>
                    <span></span>
                </div>
                @if (AbortThresholds is not null)
                {
                    <div class="cfg-row">
                        <span class="lbl"><i class="ti ti-alert-triangle"></i>Abort escalation</span>
                        <div class="val"><span class="mono" style="font-size:12px">@AbortThresholds</span></div>
                        <span></span>
                    </div>
                }
            </div>
            </ChildContent>
        </Card>

        @* Schedule — GET/PUT/DELETE /api/reports/{name}/schedule (ADR D41). Honest states: no
           Scheduling capability => explain and hide controls; no active schedule => "Not scheduled". *@
        <Card Title="Schedule" Sub="Recurring runs, evaluated in UTC">
            <ChildContent>
            @if (_capabilities is not null && !_capabilities.Scheduling)
            {
                <span class="muted" style="font-size:12px">Scheduling is not supported by this host's job scheduler.</span>
            }
            else
            {
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-clock"></i>Status</span>
                    <div class="val">
                        @if (_detail.ScheduleCron is not null)
                        {
                            <span class="mono" style="font-size:12px">@_detail.ScheduleCron</span>
                        }
                        else
                        {
                            <span class="muted">Not scheduled</span>
                        }
                        @if (_detail.ScheduleOverridden)
                        {
                            <Chip Kind="token">overridden at runtime</Chip>
                        }
                    </div>
                    <span></span>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-calendar"></i>Cron</span>
                    <div class="val" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                        <input class="mono" style="width:160px" @bind="_scheduleCronInput" @bind:event="oninput" placeholder="0 6 * * 1" />
                        <Button Variant="outline" Size="sm" OnClick="@(() => _scheduleCronInput = "0 * * * *")">Hourly</Button>
                        <Button Variant="outline" Size="sm" OnClick="@(() => _scheduleCronInput = "0 6 * * *")">Daily 06:00</Button>
                        <Button Variant="outline" Size="sm" OnClick="@(() => _scheduleCronInput = "0 6 * * 1")">Weekly Mon 06:00</Button>
                    </div>
                    <span></span>
                </div>
                @if (_scheduleError is not null)
                {
                    <Banner Variant="danger" Icon="alert-triangle"><span style="font-size:12px">@_scheduleError</span></Banner>
                }
                <div style="display:flex;gap:8px;margin-top:8px">
                    <Button Variant="primary" Loading="_savingSchedule" OnClick="SetScheduleAsync">
                        @(_detail.ScheduleCron is null ? "Set schedule" : "Update schedule")
                    </Button>
                    @if (_detail.ScheduleCron is not null || _detail.ScheduleOverridden)
                    {
                        <Button Variant="outline" Loading="_clearingSchedule" OnClick="ClearScheduleAsync">Clear</Button>
                    }
                </div>
            }
            </ChildContent>
        </Card>
    </div>

    @* History — GET /api/jobs?report={name} *@
    <Card Title="Run history" Sub="Last 10">
        <Action><Button Variant="link">View all →</Button></Action>
        <ChildContent>
        @if (_history.Count == 0)
        {
            <EmptyState Icon="report-off" Title="No runs yet">
                <ChildContent>This report hasn't been run yet.</ChildContent>
            </EmptyState>
        }
        else
        {
        <DataGrid Columns="6" Class="compact">
            <Head>
                <tr><th>When</th><th>Status</th><th>Duration</th><th>Rows</th><th>By</th><th style="width:60px"></th></tr>
            </Head>
            <Body>
                @foreach (var h in _history)
                {
                    <tr class="clickable" @onclick="@(() => Nav.NavigateTo(h.Route))">
                        <td class="mono">@h.When</td>
                        <td><JobStatusBadge Status="h.Status" LabelOverride="@h.StatusLabel" /></td>
                        <td class="mono">@h.Duration</td>
                        <td class="mono">@h.Rows</td>
                        <td>@h.By</td>
                        <td><a class="row-link mono" style="font-size:11px">view →</a></td>
                    </tr>
                }
            </Body>
        </DataGrid>
        }
        </ChildContent>
    </Card>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private bool _loading = true;
    private ApiReportDetail? _detail;
    private bool _deleting;
    private bool _confirmingDelete;
    private string? _deleteError;

    private string Description => $"{_detail!.Columns.Count} column(s) · {_detail.Formats.Count} format(s).";
    private string Destinations => _detail!.Destinations.Count > 0 ? string.Join(" + ", _detail.Destinations) : "—";
    private string? AbortThresholds => _detail is null ? null : ResilienceFormatter.FormatAbortThresholds(_detail);

    private ApiCapabilities? _capabilities;
    private string _scheduleCronInput = "";
    private bool _savingSchedule;
    private bool _clearingSchedule;
    private string? _scheduleError;

    private string NextRunLocal => _detail?.NextRunAt is { } t ? t.ToLocalTime().ToString("MMM d · HH:mm") : "—";
    private string NextRunUtc => _detail?.NextRunAt is { } t ? t.ToString("yyyy-MM-dd HH:mm") : "—";

    private async Task SetScheduleAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_scheduleCronInput))
            return;

        _savingSchedule = true;
        _scheduleError = null;
        try
        {
            bool ok = await Api.TrySetScheduleAsync(_detail.Name, _scheduleCronInput.Trim());
            if (ok)
                _detail = await Api.TryGetReportDetailAsync(_detail.Name);
            else
                _scheduleError = "The engine rejected the schedule (invalid cron, unknown report, or scheduling isn't supported).";
        }
        finally
        {
            _savingSchedule = false;
        }
    }

    private async Task ClearScheduleAsync()
    {
        if (_detail is null)
            return;

        _clearingSchedule = true;
        _scheduleError = null;
        try
        {
            bool ok = await Api.TryClearScheduleAsync(_detail.Name);
            if (ok)
            {
                _detail = await Api.TryGetReportDetailAsync(_detail.Name);
                _scheduleCronInput = "";
            }
            else
            {
                _scheduleError = "The engine rejected the request.";
            }
        }
        finally
        {
            _clearingSchedule = false;
        }
    }

    private sealed record ReportMetrics(string TotalRuns, string SuccessRate, string AvgDuration)
    {
        public static readonly ReportMetrics Unavailable = new("—", "—", "—");
    }

    private ReportMetrics _metrics = ReportMetrics.Unavailable;

    private static ReportMetrics ComputeMetrics(IReadOnlyList<ApiJobView> jobs)
    {
        var terminal = jobs.Where(j => j.Status is "Completed" or "Partial" or "Failed" or "Cancelled").ToArray();
        var completed = jobs.Where(j => j.Status == "Completed").ToArray();

        string successRate = terminal.Length > 0
            ? $"{100.0 * completed.Length / terminal.Length:0.0}%"
            : "—";

        var durations = completed
            .Where(j => j.StartedAt is not null && j.CompletedAt is not null)
            .Select(j => j.CompletedAt!.Value - j.StartedAt!.Value)
            .ToArray();
        string avgDuration = durations.Length > 0
            ? FormatDuration(DateTimeOffset.UnixEpoch, DateTimeOffset.UnixEpoch + TimeSpan.FromTicks((long)durations.Average(d => d.Ticks)))
            : "—";

        return new ReportMetrics(jobs.Count.ToString(), successRate, avgDuration);
    }

    private async Task RunNowAsync()
    {
        if (_detail is null)
            return;

        var jobId = await Api.TryRunReportAsync(_detail.Name);
        Nav.NavigateTo(jobId is not null ? $"jobs/{jobId}" : "jobs/failed");
    }

    private async Task DeleteAsync()
    {
        if (_detail is null)
            return;

        if (!_confirmingDelete)
        {
            _confirmingDelete = true;
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            bool ok = await Api.TryDeleteReportAsync(_detail.Name);
            if (ok)
                Nav.NavigateTo("reports");
            else
                _deleteError = "The engine rejected the delete request.";
        }
        finally
        {
            _deleting = false;
            _confirmingDelete = false;
        }
    }

    private sealed record HistoryRow(string When, JobStatus Status, string? StatusLabel, string Duration, string Rows, string By, string Route);

    private IReadOnlyList<HistoryRow> _history = Array.Empty<HistoryRow>();

    private static HistoryRow ToHistoryRow(ApiJobView j) => new(
        When: j.CreatedAt.ToLocalTime().ToString("MMM d · HH:mm"),
        Status: JobRowFormatter.MapStatus(j.Status),
        StatusLabel: JobRowFormatter.StatusLabelFor(j.Status),
        Duration: FormatDuration(j.StartedAt, j.CompletedAt),
        Rows: j.Stats.RecordsWritten > 0 ? j.Stats.RecordsWritten.ToString("N0") : "—",
        By: "—",
        Route: JobRowFormatter.MapRoute(j.Id, j.Status));

    private static string FormatDuration(DateTimeOffset? started, DateTimeOffset? completed)
    {
        if (started is not { } s || completed is not { } c)
            return "—";

        TimeSpan span = c - s;
        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m {span.Seconds}s" : $"{span.Seconds}s";
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _detail = await Api.TryGetReportDetailAsync(Slug);
        }
        finally
        {
            _loading = false;
        }
        _metrics = ReportMetrics.Unavailable;
        _history = Array.Empty<HistoryRow>();
        _capabilities = await Api.TryGetCapabilitiesAsync();

        if (_detail is null)
            return;

        _scheduleCronInput = _detail.ScheduleCron ?? "";

        // limit: 200 so the metric strip reflects the report's full known history, not just
        // the 10 rows shown in the table below (same pattern as Dashboard's ComputeMetrics).
        var jobs = await Api.TryListJobsAsync(report: _detail.Name, limit: 200);
        if (jobs is not null)
        {
            _history = jobs.Count > 0 ? jobs.Take(10).Select(ToHistoryRow).ToArray() : Array.Empty<HistoryRow>();
            _metrics = ComputeMetrics(jobs);
        }
    }
}
