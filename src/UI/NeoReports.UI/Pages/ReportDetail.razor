@page "/reports/{Slug}"
@using NeoReports.UI.Models
@using NeoReports.UI.Services
@inject NavigationManager Nav
@inject INeoReportsApiClient Api

@if (_report is null)
{
    <div class="page">
        <EmptyState Icon="report-off" Title="Report not found">
            <ChildContent>
                No report matches "@Slug".
            </ChildContent>
            <Action><Button Variant="outline" Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("reports"))">Back to reports</Button></Action>
        </EmptyState>
    </div>
    return;
}

<div class="page">
    @* Header — GET /api/reports/{name} *@
    <div class="page-head">
        <div class="title" style="max-width:720px">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <h1 style="font-size:24px">@_report.Name</h1>
                <div style="display:flex;gap:4px">
                    @foreach (var t in _report.Tags) { <Chip>@t</Chip> }
                    @if (_detail is not null)
                    {
                        <Chip Kind="token">origin: @_detail.Origin</Chip>
                    }
                </div>
            </div>
            <p class="sub" style="max-width:480px;margin-top:8px;line-height:1.5">@_report.Description</p>
        </div>
        <div style="display:flex;gap:8px;align-self:flex-start;margin-top:6px">
            <Button Variant="outline" Icon="pencil" OnClick="@(() => Nav.NavigateTo("builder"))">Edit</Button>
            <Button Variant="primary" Icon="player-play" OnClick="RunNowAsync">Run now</Button>
            @if (_detail is { Deletable: true })
            {
                <Button Variant="danger" Icon="trash" Loading="_deleting" OnClick="DeleteAsync">
                    @(_confirmingDelete ? "Confirm delete" : "Delete report")
                </Button>
            }
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>
    @if (_deleteError is not null)
    {
        <Banner Variant="danger" Icon="alert-triangle">
            <b>Could not delete the report</b>
            <span style="font-size:12px">@_deleteError</span>
        </Banner>
    }

    @* Metric strip — Total runs/Success rate/Avg duration computed from GET /api/jobs when live
       (Epic D / D7 pattern); Next run stays honest ("Not scheduled") since v1 has no scheduler. *@
    <div class="grid-4">
        <MetricCard Icon="player-play" Label="Total runs" Value="@_metrics.TotalRuns" Sub="@(_isLive ? "known jobs" : "since Jan 12, 2025")" />
        <MetricCard Icon="circle-check" Label="Success rate" Value="@_metrics.SuccessRate" Sub="@(_isLive ? "known jobs · terminal" : "vs last month")" DeltaDir="@(_isLive ? null : "up")" DeltaText="@(_isLive ? null : "+0.4pp")" />
        <MetricCard Icon="clock" Label="Avg duration" Value="@_metrics.AvgDuration" Sub="@(_isLive ? "completed jobs" : "last 30 days")" />
        <MetricCard Icon="calendar" Label="Next run" Value="@(_isLive ? "Not scheduled" : "Mon Jun 3")" Sub="@(_isLive ? "trigger via API or the run button" : "06:00 BRT · in 6 days")" />
    </div>

    <div>
        @* Configuration *@
        <Card Title="Configuration" Sub="Current template snapshot">
            <Action><Button Variant="link">Change history →</Button></Action>
            <ChildContent>
            <div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-database"></i>Source</span>
                    <div class="val">
                        <span class="row" style="gap:8px">
                            <CatTile Sm="true" Kind="teal" Icon="database" />
                            <span style="font-weight:500">@_report.Source</span>
                            @if (!_isLive)
                            {
                                <span class="mono muted" style="font-size:11px">SQL Server</span>
                            }
                        </span>
                    </div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-columns"></i>Columns</span>
                    <div class="val">
                        @if (_detail is not null)
                        {
                            <span>@_detail.Columns.Count selected</span>
                            <span class="mono muted" style="font-size:11px">@string.Join(", ", _detail.Columns.Select(c => c.Name))</span>
                        }
                        else
                        {
                            <span>6 selected</span>
                            <span class="mono muted" style="font-size:11px">id, customer_id, total, created_at, status_id, region</span>
                        }
                    </div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-file-text"></i>Formats</span>
                    <div class="val">
                        <div class="pipeline-chips" style="gap:4px">
                            @foreach (var f in _report.Formats)
                            {
                                <Chip Kind="format" Ext="@f.ToLower()">@f</Chip>
                            }
                        </div>
                    </div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-cloud-upload"></i>Destinations</span>
                    <div class="val"><span>@_report.Destination</span></div>
                    <button class="edit-link">edit</button>
                </div>
                <div class="cfg-row">
                    <span class="lbl"><i class="ti ti-shield-check"></i>Resilience</span>
                    <div class="val"><span class="mono" style="font-size:12px">@ResilienceSummary</span></div>
                    <span></span>
                </div>
            </div>
            </ChildContent>
        </Card>
    </div>

    @* History — GET /api/jobs?report={name} when live, sample rows otherwise *@
    <Card Title="Run history" Sub="@(_isLive ? "Last 10" : "Last 5")">
        <Action><Button Variant="link">View all →</Button></Action>
        <ChildContent>
        @if (_history.Count == 0)
        {
            <EmptyState Icon="report-off" Title="No runs yet">
                <ChildContent>This report hasn't been run yet.</ChildContent>
            </EmptyState>
        }
        else
        {
        <DataGrid Columns="6" Class="compact">
            <Head>
                <tr><th>When</th><th>Status</th><th>Duration</th><th>Rows</th><th>By</th><th style="width:60px"></th></tr>
            </Head>
            <Body>
                @foreach (var h in _history)
                {
                    <tr class="clickable" @onclick="@(() => Nav.NavigateTo(h.Route))">
                        <td class="mono">@h.When</td>
                        <td><JobStatusBadge Status="h.Status" LabelOverride="@(h.Status == JobStatus.Ok ? "Completed" : null)" /></td>
                        <td class="mono">@h.Duration</td>
                        <td class="mono">@h.Rows</td>
                        <td>@h.By</td>
                        <td><a class="row-link mono" style="font-size:11px">view →</a></td>
                    </tr>
                }
            </Body>
        </DataGrid>
        }
        </ChildContent>
    </Card>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private ReportSummary? _report;
    private ApiReportDetail? _detail;
    private bool _isLive;
    private bool _deleting;
    private bool _confirmingDelete;
    private string? _deleteError;

    private sealed record ReportMetrics(string TotalRuns, string SuccessRate, string AvgDuration)
    {
        public static readonly ReportMetrics Demo = new("386", "98.7%", "3m 24s");
    }

    private ReportMetrics _metrics = ReportMetrics.Demo;

    private static ReportMetrics ComputeMetrics(IReadOnlyList<ApiJobView> jobs)
    {
        var terminal = jobs.Where(j => j.Status is "Completed" or "Failed" or "Cancelled").ToArray();
        var completed = jobs.Where(j => j.Status == "Completed").ToArray();

        string successRate = terminal.Length > 0
            ? $"{100.0 * completed.Length / terminal.Length:0.0}%"
            : "—";

        var durations = completed
            .Where(j => j.StartedAt is not null && j.CompletedAt is not null)
            .Select(j => j.CompletedAt!.Value - j.StartedAt!.Value)
            .ToArray();
        string avgDuration = durations.Length > 0
            ? FormatDuration(DateTimeOffset.UnixEpoch, DateTimeOffset.UnixEpoch + TimeSpan.FromTicks((long)durations.Average(d => d.Ticks)))
            : "—";

        return new ReportMetrics(jobs.Count.ToString(), successRate, avgDuration);
    }

    private string ResilienceSummary => _detail is null
        ? "5× retries · exp 2s..30s · jitter · abort if >10% errors"
        : ResilienceFormatter.Format(_detail);

    private async Task RunNowAsync()
    {
        if (!_isLive || _report is null)
        {
            Nav.NavigateTo("jobs/7c4a01f3");
            return;
        }

        var jobId = await Api.TryRunReportAsync(_report.Name);
        Nav.NavigateTo(jobId is not null ? $"jobs/{jobId}" : "jobs/failed");
    }

    private async Task DeleteAsync()
    {
        if (_detail is null)
            return;

        if (!_confirmingDelete)
        {
            _confirmingDelete = true;
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            bool ok = await Api.TryDeleteReportAsync(_detail.Name);
            if (ok)
                Nav.NavigateTo("reports");
            else
                _deleteError = "The engine rejected the delete request.";
        }
        finally
        {
            _deleting = false;
            _confirmingDelete = false;
        }
    }

    private sealed record HistoryRow(string When, JobStatus Status, string Duration, string Rows, string By, string Route);

    private static readonly HistoryRow[] DemoHistory =
    {
        new("May 27 · 14:32", JobStatus.Running, "2m 18s", "26,624", "marina.s · manual", "jobs/7c4a01f3"),
        new("May 3 · 06:00",  JobStatus.Ok,      "3m 36s", "42,184", "schedule", "jobs/completed/7c4a01f3"),
        new("Apr 1 · 06:00",  JobStatus.Ok,      "3m 41s", "39,812", "schedule", "jobs/completed/7c4a01f3"),
        new("Mar 1 · 06:00",  JobStatus.Failed,  "1m 22s", "—",      "schedule", "jobs/failed/8b2f01a9"),
        new("Feb 1 · 06:00",  JobStatus.Ok,      "4m 02s", "38,118", "schedule", "jobs/completed/7c4a01f3"),
    };

    private IReadOnlyList<HistoryRow> _history = DemoHistory;

    private static HistoryRow ToHistoryRow(ApiJobView j) => new(
        When: j.CreatedAt.ToLocalTime().ToString("MMM d · HH:mm"),
        Status: j.Status switch
        {
            "Completed" => JobStatus.Ok,
            "Failed" => JobStatus.Failed,
            "Running" or "Retrying" => JobStatus.Running,
            "Paused" => JobStatus.Paused,
            _ => JobStatus.Queued,
        },
        Duration: FormatDuration(j.StartedAt, j.CompletedAt),
        Rows: j.Stats.RecordsWritten > 0 ? j.Stats.RecordsWritten.ToString("N0") : "—",
        By: "—",
        Route: j.Status switch
        {
            "Completed" => $"jobs/completed/{j.Id}",
            "Failed" => $"jobs/failed/{j.Id}",
            _ => $"jobs/{j.Id}",
        });

    private static string FormatDuration(DateTimeOffset? started, DateTimeOffset? completed)
    {
        if (started is not { } s || completed is not { } c)
            return "—";

        TimeSpan span = c - s;
        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m {span.Seconds}s" : $"{span.Seconds}s";
    }

    protected override async Task OnParametersSetAsync()
    {
        // Demo slugs resolve from sample data first (unaffected by whether an engine is
        // mounted); an unknown slug falls back to GET /api/reports/{name} (Epic D / D4) so a
        // real registered report shows its actual columns/formats/destinations/retry/origin
        // instead of "not found".
        _report = SampleData.Reports.FirstOrDefault(r => r.Slug == Slug);
        if (_report is null)
        {
            _detail = await Api.TryGetReportDetailAsync(Slug);
            if (_detail is not null)
            {
                _isLive = true;
                _report = new ReportSummary(
                    Slug: Slug,
                    Name: _detail.Name,
                    Description: $"{_detail.Columns.Count} column(s) · {_detail.Formats.Count} format(s).",
                    Tags: Array.Empty<string>(),
                    Status: JobStatus.Never,
                    Source: "—",
                    Formats: _detail.Formats.ToArray(),
                    Destination: _detail.Destinations.Count > 0 ? string.Join(" + ", _detail.Destinations) : "—",
                    ScheduleTitle: "Not scheduled",
                    ScheduleSub: "trigger via API or the run button",
                    LastTitle: "—",
                    LastSub: "never run",
                    CatKind: "gray",
                    CatIcon: "report");
            }
        }
        if (_report is null)
            return;

        if (_isLive)
        {
            // limit: 200 so the metric strip reflects the report's full known history, not just
            // the 10 rows shown in the table below (same pattern as Dashboard's ComputeMetrics).
            var jobs = await Api.TryListJobsAsync(report: _report.Name, limit: 200);
            if (jobs is not null)
            {
                _history = jobs.Count > 0 ? jobs.Take(10).Select(ToHistoryRow).ToArray() : Array.Empty<HistoryRow>();
                _metrics = ComputeMetrics(jobs);
            }
        }
    }
}
