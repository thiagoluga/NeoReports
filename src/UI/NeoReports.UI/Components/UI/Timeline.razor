@* Timeline — event list: [time mono] [round icon] [text + detail].
   Icon color by kind: info (gray), ok (green), warn (amber), err (red).
   Internal vertical scroll (max-height) unless Expanded.
   Usage:
     <Timeline Events="@events" />
   where events is EventRow[] { new("14:32:06","ok","check","Connection established","vendas-db · 142ms") } *@

<div class="tl" style="@(Expanded ? "max-height:none" : "")">
    @foreach (var e in Events)
    {
        <span class="ts">@e.Time</span>
        <span class="ic @e.Kind"><i class="ti ti-@e.Icon"></i></span>
        <span class="text">
            @e.Text
            @if (!string.IsNullOrEmpty(e.Detail))
            {
                <span class="detail">@e.Detail</span>
            }
        </span>
    }
</div>

@code {
    /// <summary>kind: "info" | "ok" | "warn" | "err"</summary>
    public record EventRow(string Time, string Kind, string Icon, string Text, string? Detail = null);

    [Parameter] public EventRow[] Events { get; set; } = Array.Empty<EventRow>();

    /// <summary>Removes the internal max-height scroll.</summary>
    [Parameter] public bool Expanded { get; set; }
}
