@* DestinationCard — selectable destination card (builder step 4).
   Usage:  <DestinationCard Destination="d" Selected="@sel" OnClick="..." /> *@
@using NeoReports.UI.Models

<SelectableCard Selected="Selected" OnClick="OnClick">
    <CatTile Kind="@Destination.Kind" Icon="@Destination.Icon" />
    <div class="name">@Destination.Name</div>
    <div class="conn" style="white-space:normal;font-family:var(--font-sans);font-size:12px">@Destination.Description</div>
</SelectableCard>

@code {
    [Parameter] public DestinationOption Destination { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
