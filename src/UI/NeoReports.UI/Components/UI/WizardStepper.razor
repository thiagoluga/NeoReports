@* WizardStepper — numbered step strip. done=green+check, active=black, pending=gray.
   Usage:  <WizardStepper Steps="@(new[]{"Source","Columns","Format","Destination","Review"})" Current="2" /> *@

<div class="wizard">
    @* Shown only under the sm breakpoint (see neoreports.css); the full step list below is
       hidden there instead — too dense to read at that width. *@
    <span class="wizard-compact">Step @(Current + 1) of @Steps.Length</span>
    @for (var i = 0; i < Steps.Length; i++)
    {
        var state = StateOf(i);
        if (i > 0)
        {
            <span class="wconn"></span>
        }
        <span class="wstep @state">
            <span class="wnum">
                @if (i < Current)
                {
                    <i class="ti ti-check" style="font-size:10px"></i>
                }
                else
                {
                    @(i + 1)
                }
            </span>
            @Steps[i]
        </span>
    }
</div>

@code {
    [Parameter] public string[] Steps { get; set; } = Array.Empty<string>();

    /// <summary>Current step index (0-based)</summary>
    [Parameter] public int Current { get; set; }

    private string StateOf(int i)
    {
        if (i < Current) return "done";
        return i == Current ? "active" : "";
    }
}
