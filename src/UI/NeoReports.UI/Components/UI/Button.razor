@* Button — variants: primary (black), outline, subtle, danger, link.
   Usage:  <Button Variant="primary" Icon="plus" OnClick="...">New report</Button> *@

<button type="@Type" class="btn @Variant @SizeClass @(Class)" disabled="@Disabled" @onclick="OnClick" @attributes="Extra">
    @if (Loading)
    {
        <i class="ti ti-loader-2" style="animation:spin 0.9s linear infinite"></i>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <i class="ti ti-@Icon"></i>
    }
    @ChildContent
    @if (!string.IsNullOrEmpty(IconRight))
    {
        <i class="ti ti-@IconRight"></i>
    }
</button>

@code {
    /// <summary>primary | outline | subtle | danger | link</summary>
    [Parameter] public string Variant { get; set; } = "outline";

    /// <summary>"sm" for a small button; null for default</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Tabler icon name without the prefix (e.g. "plus", "player-play")</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Icon to the right of the label (e.g. "arrow-right")</summary>
    [Parameter] public string? IconRight { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a spinner in place of the leading icon.</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Extra { get; set; }

    private string SizeClass => Size ?? "";
}
