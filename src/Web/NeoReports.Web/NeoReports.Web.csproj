<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoReports.Web</RootNamespace>
    <!-- App (not a library package): no nupkg, and no XML-doc requirement on the
         generated-public Razor component classes. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    NeoReports Blazor Server UI (Epic C), built from the Claude Design handoff
    (docs/ui-handoff.md). Run with `dotnet run`; served under /neoreports.
  -->

</Project>
