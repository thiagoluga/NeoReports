@* FormatCard — selectable output-format card (builder step 3).
   Usage:  <FormatCard Format="f" Selected="@sel" OnClick="..." /> *@
@using NeoReports.Web.Models

<SelectableCard Selected="Selected" OnClick="OnClick">
    <CatTile Kind="@Format.Kind" Icon="@Format.Icon" />
    <div class="name">
        @Format.Name
        <span class="mono muted" style="font-size:11px;font-weight:400">@Format.Ext</span>
    </div>
    <div class="conn" style="white-space:normal;font-family:var(--font-sans);font-size:12px">@Format.Description</div>
</SelectableCard>

@code {
    [Parameter] public FormatOption Format { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
