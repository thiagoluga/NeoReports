@* SourceCard — list item for a registered source.
   Head: cat tile + name + type pill + health badge + Explore/Diagnose action.
   Body: PAGINATION / P95 LATENCY / USED IN / LAST QUERY grid.
   Usage:  <SourceCard Source="s" OnExplore="@(() => Nav.NavigateTo($"sources/{s.Id}/explore"))" /> *@
@using NeoReports.Web.Models

@{
    var (hv, hi, hl) = StatusMaps.HealthBadge(Source.Health);
    var isError = Source.Health == Health.Error;
}
<div class="src-card">
    <div class="sc-head">
        <CatTile Kind="@Source.CatKind" Icon="@Source.CatIcon" />
        <div class="info">
            <div class="title-row">
                <span class="title">@Source.Name</span>
                <span class="badge gray" style="background:var(--bg2)"><span class="dot" style="background:var(--fg-faint)"></span>@Source.Type</span>
                <Badge Variant="@hv" Icon="@hi">@hl</Badge>
            </div>
            <span class="conn">@Source.Connection</span>
        </div>
        <div class="actions">
            <Button Variant="@(isError ? "danger" : "outline")" Size="sm" Icon="@(isError ? "tool" : "eye")"
                    OnClick="OnExplore">@(isError ? "Diagnose" : "Explore")</Button>
            <button class="btn icon-only sm subtle"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>
    <div class="sc-body">
        <div class="cell"><span class="k">Pagination</span><span class="v">@Source.Pagination</span></div>
        <div class="cell"><span class="k">P95 latency</span><span class="v">@Source.P95</span></div>
        <div class="cell"><span class="k">Used in</span><span class="v">@Source.UsedIn reports</span></div>
        <div class="cell"><span class="k">Last query</span><span class="v">@Source.LastQuery</span></div>
    </div>
</div>

@code {
    [Parameter] public SourceSummary Source { get; set; } = default!;
    [Parameter] public EventCallback OnExplore { get; set; }
}
