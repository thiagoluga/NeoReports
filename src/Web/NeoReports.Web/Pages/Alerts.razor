@page "/settings/alerts"
@using NeoReports.Web.Components.UI
@inject NavigationManager Nav

<div class="page">
    <SubNav Active="alerts" />

    <div class="page-head">
        <div class="title"><h1>Alerts</h1><div class="sub">Alert rules · connected channels · quiet hours</div></div>
        <Button Variant="primary" Icon="plus">New rule</Button>
    </div>

    <div class="global-strip">
        <div class="stats">
            <span class="stat"><b>4</b> active rules</span>
            <span class="stat"><b>3</b> connected channels</span>
            <span class="stat muted">Quiet hours <b>22:00–07:00</b> · except critical</span>
        </div>
        <button class="btn link">Global settings →</button>
    </div>

    <div>
        <p class="label-sm" style="margin-bottom:10px">Channels</p>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
            @foreach (var c in _channels)
            {
                <div class="channel-card @(c.On ? "" : "off")">
                    <div class="ch-head"><CatTile Kind="@c.Kind" Icon="@c.Icon" /><Switch Value="c.On" /></div>
                    <div><div class="ch-name">@c.Name</div><div class="ch-detail">@c.Detail</div></div>
                    <div class="ch-foot"><span>@(c.On ? $"used in {c.UsedIn} rules" : "disabled")</span><button class="btn link" style="font-size:12px">@(c.On ? "Configure" : "Connect")</button></div>
                </div>
            }
        </div>
    </div>

    <div>
        <p class="label-sm" style="margin-bottom:10px">Alert rules</p>
        <div class="col" style="gap:10px">
            @foreach (var r in _rules)
            {
                <div class="rule-card" style="@(r.On ? "" : "opacity:0.6")">
                    <div class="rl-head">
                        <CatTile Kind="@r.Kind" Icon="@r.Icon" />
                        <div class="rl-meta">
                            <div class="rl-title"><b>@r.Name</b>@if (r.Priority is not null){<Badge Variant="danger" Icon="alert-octagon">@r.Priority · ignores quiet hours</Badge>}</div>
                            <span class="rl-scope">@r.Scope</span>
                        </div>
                        <div class="rl-actions"><Switch Value="r.On" /><Button Variant="outline" Size="sm" Icon="pencil">Edit</Button><button class="btn icon-only sm subtle"><i class="ti ti-dots-vertical"></i></button></div>
                    </div>
                    <div class="rl-body">
                        <span class="rb-k">When</span>
                        <span class="rb-v">
                            @for (var i = 0; i < r.When.Length; i++)
                            {
                                if (i > 0) { <span class="cond-op">AND</span> }
                                <span class="cond-chip">@r.When[i]</span>
                            }
                        </span>
                        <span class="rb-k">Sends</span>
                        <span class="rb-v">@foreach (var ch in r.Sends){<span class="cond-chip info"><i class="ti ti-@ch" style="font-size:11px"></i>@ch.Replace("brand-", "")</span>}</span>
                        <span class="rb-k">Limit</span>
                        <span class="rb-v"><span style="color:var(--fg-muted)">@r.Limit</span></span>
                    </div>
                </div>
            }
        </div>
    </div>

    <Card Title="Recent activity" Sub="Last 24h · 4 alerts fired">
        <Timeline Events="_recent" Expanded="true" />
    </Card>
</div>

@code {
    private record Channel(string Kind, string Icon, string Name, string Detail, int UsedIn, bool On);
    private readonly Channel[] _channels =
    {
        new("warn", "mail", "Email · SMTP", "finance@acme.com · ops@acme.com · 3 more", 3, true),
        new("purple", "brand-slack", "Slack", "#reports-prod · #incidents", 4, true),
        new("info", "webhook", "Webhook", "https://acme.pagerduty.com/integrations/neoreports", 1, true),
        new("info", "brand-teams", "Microsoft Teams", "not configured", 0, false),
        new("danger", "bell-ringing", "PagerDuty", "not configured", 0, false),
        new("gray", "bell", "In-app", "all admins · 4 recipients", 2, true),
    };

    private record Rule(string Kind, string Icon, string Name, string Scope, bool On, string? Priority, string[] When, string[] Sends, string Limit);
    private readonly Rule[] _rules =
    {
        new("danger", "alert-triangle", "Critical failure", "applies to all reports tagged \"critical\"", true, "critical",
            new[] { "job.status = failed", "report.tags contains \"critical\"" }, new[] { "mail", "brand-slack", "webhook" }, "No limit · every incident notifies"),
        new("warn", "calendar-x", "Schedule did not run", "applies to 28 recurring reports", true, null,
            new[] { "schedule.expected_at + 15min", "no job started" }, new[] { "mail", "brand-slack" }, "Max 1 alert every 30 min per report"),
        new("warn", "clock-exclamation", "Duration 2x above average", "applies to all reports", true, null,
            new[] { "job.duration > 2× avg(last 10)", "job.duration > 5min" }, new[] { "brand-slack" }, "Max 1 alert every 15 min per report"),
        new("info", "refresh-alert", "Excessive retries", "applies to all reports", false, null,
            new[] { "job.retries ≥ 10" }, new[] { "brand-slack" }, "Max 1 alert every 1h per report"),
    };

    private readonly Timeline.EventRow[] _recent =
    {
        new("01:01:22", "err", "alert-triangle", "Daily audit log · Critical failure", "job_8b2f01a9 · threshold exceeded · 15 retries exhausted"),
        new("14:21:08", "warn", "clock-exclamation", "Monthly sales · duration 2x above average", "job_4a1d · 8m 12s vs 3m 24s avg"),
        new("13:30:00", "warn", "calendar-x", "Finance backup · schedule did not run", "expected 13:15:00 BRT · 15 min late"),
        new("yesterday", "warn", "refresh-alert", "Low stock · excessive retries (disabled)", "job_2c1f · 11 retries · rule disabled by marina.s"),
    };
}
