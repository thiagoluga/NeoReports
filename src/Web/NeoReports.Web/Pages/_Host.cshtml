@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace NeoReports.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The UI is mounted under a configurable base path (UseNeoReportsUi). The branch
       middleware moves the mount point into PathBase, so the base tag adapts to
       whatever path the host chose; the trailing slash is the href terminator. *@
    <base href="@(HttpContext.Request.PathBase.Value)/" />

    <title>NeoReports</title>

    <!-- Design-system tokens (colors, type, spacing) -->
    <link rel="stylesheet" href="_content/NeoReports.Web/css/tokens.css" />
    <!-- Component styles -->
    <link rel="stylesheet" href="_content/NeoReports.Web/css/neoreports.css" />
    <!-- Tabler icons (self-host in production; see wwwroot/fonts/README.md) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.30.0/dist/tabler-icons.min.css"
          integrity="sha384-9pcqeAMNPuuw0/mltfCMqqVUmfHeTASX43egMosvWSN+Dh5eUCFi9Iz3yIW5sIsM" crossorigin="anonymous" />
    <link rel="icon" href="_content/NeoReports.Web/assets/logo-mark.svg" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        An unhandled error occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
