@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace NeoReports.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    var basePath = "/neoreports";
}

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@basePath/" />

    <title>NeoReports</title>

    <!-- Design-system tokens (colors, type, spacing) -->
    <link rel="stylesheet" href="css/tokens.css" />
    <!-- Component styles -->
    <link rel="stylesheet" href="css/neoreports.css" />
    <!-- Tabler icons (self-host in production; see wwwroot/fonts/README.md) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.30.0/dist/tabler-icons.min.css" />
    <link rel="icon" href="assets/logo-mark.svg" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        An unhandled error occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
