@page "/jobs/completed"
@using NeoReports.Web.Components.UI
@inject NavigationManager Nav

<div class="page">
    <div class="page-head">
        <div class="title">
            <div style="display:flex;align-items:center;gap:12px">
                <h1 style="font-size:24px">Monthly sales · retail</h1>
                <Badge Variant="success" Icon="check">Completed</Badge>
            </div>
            <div class="sub mono" style="margin-top:6px">job_7c4a01f3 · run by marina.s · finished 14:35:54 BRT</div>
        </div>
        <div style="display:flex;gap:8px">
            <Button Variant="outline" Icon="refresh" OnClick="@(() => Nav.NavigateTo("jobs/7c4a01f3"))">Run again</Button>
            <Button Variant="outline" Icon="link">Copy link</Button>
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>

    <div class="hero-status success">
        <div class="badge-ico"><i class="ti ti-check"></i></div>
        <div>
            <div class="title">Report generated successfully</div>
            <div class="sub">42,184 rows processed in 3m 36s · 2 formats · 2 destinations confirmed</div>
        </div>
        <Button Variant="danger" Icon="trash"></Button>
    </div>

    <Card Flat="true" Dense="true"><PhaseStepper Phases="_phases" /></Card>

    <div class="grid-4">
        <MetricCard Icon="download" Label="Read" Value="42,184" Sub="batch size 1k" />
        <MetricCard Icon="upload" Label="Written" Value="42,184" Sub="0 dropped" />
        <MetricCard Icon="clock" Label="Duration" Value="3m 36s" Sub="vs 4m 32s avg" DeltaDir="up" DeltaText="-56s" />
        <MetricCard Icon="refresh" Label="Retries" Value="1" Sub="recovered · resilience OK" />
    </div>

    @* Files — GET /api/jobs/{id}/download *@
    <Card Title="Generated files" Sub="Final snapshot · available for 7 days">
        <div>
            <div class="file-row">
                <CatTile Sm="true" Kind="teal" Icon="table" />
                <div class="file-name"><b>sales-2026-05-27.csv</b><span>2.41 MB · 42,184 rows · UTF-8 · comma-delimited</span></div>
                <div class="file-actions"><Button Variant="outline" Size="sm" Icon="eye">Preview</Button><Button Variant="primary" Size="sm" Icon="download">Download</Button></div>
            </div>
            <div class="file-row">
                <CatTile Sm="true" Kind="teal" Icon="file-spreadsheet" />
                <div class="file-name"><b>sales-2026-05-27.xlsx</b><span>3.82 MB · 42,184 rows · "Sales" sheet · auto-filter · freeze header</span></div>
                <div class="file-actions"><Button Variant="outline" Size="sm" Icon="eye">Preview</Button><Button Variant="primary" Size="sm" Icon="download">Download</Button></div>
            </div>
        </div>
    </Card>

    <Card>
        <TitleContent>Destinations</TitleContent>
        <SubContent><span style="color:var(--success-fg)"><i class="ti ti-check" style="font-size:12px;margin-right:4px"></i>2 of 2 delivered</span></SubContent>
        <ChildContent>
        <div>
            <div class="dest-row">
                <CatTile Sm="true" Kind="info" Icon="cloud-upload" />
                <div><div class="d-name">SharePoint · acme.sharepoint.com</div><div class="d-path">/Sales/2026/05/sales-2026-05-27.xlsx</div></div>
                <span class="d-time">✓ 14:35:38</span>
                <Button Variant="outline" Size="sm" Icon="external-link">Open</Button>
            </div>
            <div class="dest-row">
                <CatTile Sm="true" Kind="info" Icon="brand-aws" />
                <div><div class="d-name">Amazon S3</div><div class="d-path">s3://acme-reports/retail/2026/05/sales-2026-05-27.csv</div></div>
                <span class="d-time">✓ 14:35:54</span>
                <Button Variant="outline" Size="sm" Icon="external-link">Open</Button>
            </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--bg2);border-radius:var(--r-md);margin-top:4px">
            <span class="muted" style="font-size:12px">Want to send to another destination?</span>
            <Button Variant="outline" Size="sm" Icon="plus">Send to…</Button>
        </div>
        </ChildContent>
    </Card>

    <div class="grid-1-5">
        <Card Title="Timeline" Sub="Full sequence">
            <Action><button class="btn link">View full logs</button></Action>
            <ChildContent>
                <Timeline Events="_events" Expanded="true" />
            </ChildContent>
        </Card>
        <Card Title="Configuration" Sub="Snapshot of what ran">
            <div class="kv">
                <span class="k">Source</span><span class="v mono">sales-db · SQL Server</span>
                <span class="k">Formats</span><span class="v">CSV, XLSX</span>
                <span class="k">Buffer</span><span class="v mono">1,000 rows/page</span>
                <span class="k">Retry policy</span><span class="v mono">5× · exp 2s..30s · jitter</span>
                <span class="k">Worker</span><span class="v mono">worker-04 · default pool</span>
            </div>
            <div class="row" style="padding-top:12px;border-top:0.5px solid var(--border);margin-top:4px">
                <span class="muted" style="font-size:12px">Run by</span>
                <span style="font-weight:500;font-size:13px">marina.s</span>
                <span class="mono muted" style="font-size:11px;margin-left:auto">manual · 14:32:06</span>
            </div>
        </Card>
    </div>
</div>

@code {
    private readonly PhaseStepper.Phase[] _phases =
    {
        new("Connect", "done"), new("Authenticate", "done"), new("Schema", "done"),
        new("Read+write", "done"), new("Upload", "done"),
    };

    private readonly Timeline.EventRow[] _events =
    {
        new("14:32:06", "info", "info-circle", "Started by marina.s", "trigger: manual · job_7c4a01f3"),
        new("14:32:07", "ok", "check", "Connection established", "sales-db · 142ms"),
        new("14:33:11", "warn", "alert-triangle", "Retry after lock-timeout", "attempt 2 of 5 · backoff exp 4s"),
        new("14:33:15", "ok", "check", "Retry recovered", "resumed at page 12"),
        new("14:35:18", "ok", "check", "Pages 1-42 written", "42,184 / 42,184 rows"),
        new("14:35:38", "ok", "cloud-upload", "SharePoint upload OK", "3.82 MB · 1.2s"),
        new("14:35:54", "ok", "cloud-upload", "S3 upload OK", "2.41 MB · 0.8s"),
        new("14:35:54", "ok", "flag-check", "Job completed", "duration 3m 36s · 0 final failures"),
    };
}
