@page "/pipeline"
@using NeoReports.Web.Models
@inject NavigationManager Nav

<div class="page">
    <div class="page-head">
        <div class="title">
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <h1 style="font-size:24px">Regional sales</h1>
                <Badge Variant="purple" Icon="stack-2">pipeline · 3 variants</Badge>
            </div>
            <div class="sub" style="margin-top:8px;max-width:540px;line-height:1.5">
                Daily snapshot of regional sales with 3 variants: full BI dataset, a filtered sales-team cut, and a leadership drop alert.
            </div>
        </div>
        <div style="display:flex;gap:8px">
            <Button Variant="outline" Icon="pencil">Edit</Button>
            <Button Variant="primary" Icon="player-play">Run pipeline</Button>
            <button class="btn icon-only outline"><i class="ti ti-dots-vertical"></i></button>
        </div>
    </div>

    @* Legend *@
    <div class="global-strip" style="background:var(--bg2)">
        <div class="stats">
            <span class="stat"><b>shared</b> <span class="muted">= source · schema · base columns</span></span>
            <span class="stat"><b>variant</b> <span class="muted">= filter · format · destination · schedule</span></span>
        </div>
        <span class="mono muted" style="font-size:11px">each variant spawns an independent job</span>
    </div>

    <div class="grid-4">
        <MetricCard Icon="stack-2" Label="Variants" Value="3" Sub="active · 0 paused" />
        <MetricCard Icon="player-play" Label="Runs (30d)" Value="92" Sub="≈ 3/day · 1 per variant" />
        <MetricCard Icon="circle-check" Label="Success rate" Value="97.8%" Sub="vs last month" DeltaDir="up" DeltaText="+1.2pp" />
        <MetricCard Icon="calendar" Label="Next run" Value="Wed May 28" Sub="06:00 BRT · in 1 day" />
    </div>

    <div class="pipeline-card">
        <div class="pc-head">
            <span class="pc-stack"><i class="ti ti-stack-2"></i></span>
            <div style="min-width:0">
                <div class="pc-name">
                    <h2>regional-sales</h2>
                    <span class="mono muted" style="font-size:12px">sales-db → 3 variants</span>
                </div>
                <p class="pc-desc">Pipeline sharing source and schema across 3 outputs with different filters, formats and destinations.</p>
                <div class="pc-stats">
                    <span><b>3</b> variants</span>
                    <span><b>92</b> runs / 30d</span>
                    <span><b>97.8%</b> success</span>
                    <span>next: <b class="mono">Wed 06:00</b></span>
                </div>
            </div>
        </div>

        @* Shared sections *@
        <div class="pc-shared">
            <span class="k">Source</span>
            <span class="v">
                <span class="cond-chip"><i class="ti ti-database" style="font-size:11px;margin-right:4px;color:var(--teal-fg)"></i>sales-db</span>
                <span class="cond-op">·</span>
                <span class="cond-chip mono">SQL Server</span>
            </span>
            <span class="k">Query</span>
            <span class="v">
                <span class="cond-chip mono">regional-sales.sql</span>
                <span class="muted" style="font-size:11px">v.created_at BETWEEN @@since AND @@until · LEFT JOIN regions</span>
            </span>
            <span class="k">Columns</span>
            <span class="v">
                @foreach (var c in new[] { "id", "region", "customer_id", "product_id", "qty", "total", "created_at" })
                {
                    <span class="cond-chip mono">@c</span>
                }
            </span>
        </div>

        @* Variants *@
        @foreach (var v in _variants)
        {
            <div class="variant-row">
                <i class="ti ti-git-branch branch"></i>
                <CatTile Sm="true" Kind="@v.IconKind" Icon="@v.IconName" />
                <div class="v-meta">
                    <div class="v-title">
                        <b class="mono">@v.Name</b>
                        <span class="tag" style="background:var(--bg2);font-family:var(--font-mono);font-size:11px">@v.Type</span>
                    </div>
                    <div class="v-cfg">
                        <span class="k">Filter</span>
                        <span class="v">
                            @if (v.Filter is null)
                            {
                                <span class="muted" style="font-size:11px">no filter · full dataset</span>
                            }
                            else
                            {
                                <span class="cond-chip mono">@v.Filter</span>
                            }
                        </span>
                        <span class="k">Output</span>
                        <span class="v">
                            <span class="cond-chip" style="@(v.FormatIsPdf ? "background:var(--coral-bg);color:var(--coral-fg)" : "background:var(--teal-bg);color:var(--teal-fg)")">@v.Format</span>
                            <span class="cond-op">→</span>
                            <span class="cond-chip"><i class="ti ti-@v.DestIcon" style="font-size:11px;margin-right:4px"></i>@v.Destination</span>
                        </span>
                        <span class="k">Schedule</span>
                        <span class="v"><span class="cond-chip mono">@v.Schedule</span></span>
                    </div>
                </div>
                <div class="v-stats">
                    <Badge Variant="@v.StatusVariant" Icon="@v.StatusIcon">@v.StatusLabel</Badge>
                    <span class="mono">@v.Time</span>
                    <span class="mono">@v.Rows</span>
                </div>
                <div class="v-actions">
                    <Button Variant="outline" Size="sm" Icon="player-play" OnClick="@(() => Nav.NavigateTo("jobs/7c4a01f3"))"></Button>
                    <button class="btn icon-only sm subtle"><i class="ti ti-dots-vertical"></i></button>
                </div>
            </div>
        }

        <div class="pc-foot"><button>+ New variant</button></div>
    </div>
</div>

@code {
    private record Variant(string Name, string Type, string? Filter, string Format, bool FormatIsPdf,
        string Destination, string DestIcon, string Schedule, string IconKind, string IconName,
        string StatusVariant, string StatusIcon, string StatusLabel, string Time, string Rows);

    private readonly Variant[] _variants =
    {
        new("full", "no filter", null, "XLSX", false, "SharePoint · /BI/Sales", "brand-office",
            "every day · 06:00 BRT", "teal", "table", "success", "check", "OK", "yesterday 06:00", "42,184 rows"),
        new("southeast-region", "client-filtered", "region = 'SE'", "CSV", false, "Email · sales-se@@acme.com", "mail",
            "Mon/Wed/Fri · 07:00 BRT", "teal", "table", "success", "check", "OK", "yesterday 07:00", "14,812 rows"),
        new("sales-drop-alert", "alert-filtered", "qty 7d < qty 28d-avg × 0.6", "PDF", true, "Email · leadership@@acme.com", "mail",
            "every day · 07:30 BRT", "coral", "alert-triangle", "warn", "alert-triangle", "drop detected", "today 07:30", "3 regions"),
    };
}
