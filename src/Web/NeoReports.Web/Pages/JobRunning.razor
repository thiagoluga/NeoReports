@page "/jobs/{Id}"
@using NeoReports.Web.Components.UI
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    <div class="page-head">
        <div class="title">
            <div style="display:flex;align-items:center;gap:12px">
                <h1 style="font-size:24px">Monthly sales · retail</h1>
                <Badge Variant="info" Icon="player-play" Live="true">Running</Badge>
            </div>
            <div class="sub mono" style="margin-top:6px">job_@Id · started by marina.s · manual trigger</div>
        </div>
        <div style="display:flex;gap:8px">
            <Button Variant="outline" Icon="refresh">Refresh</Button>
            @* POST /api/jobs/{id}/cancel *@
            <Button Variant="danger" Icon="player-stop">Cancel</Button>
        </div>
    </div>

    @* Progress hero — GET /api/jobs/{id} (polled/streamed) *@
    <div class="progress-hero">
        <div class="top">
            <div style="display:flex;align-items:baseline;gap:16px">
                <span class="pctbig">@_pct%</span>
                <span class="where">Writing page @(_pct * 42 / 100) of 42 · CSV + XLSX</span>
            </div>
            <span class="live-indicator"><span class="dot"></span>live</span>
        </div>
        <div class="progress-bar"><i style="width:@(_pct)%"></i></div>
        <div class="foot"><span>Elapsed 2m 18s</span><span>ETA ~1m 18s · finish ~14:35:54</span></div>
    </div>

    <Card Flat="true" Dense="true">
        <PhaseStepper Phases="_phases" />
    </Card>

    <div class="grid-4">
        <MetricCard Icon="download" Label="Read" Value="26,871" Sub="of ~42,000" />
        <MetricCard Icon="upload" Label="Written" Value="26,624" Sub="247 buffered" />
        <MetricCard Icon="activity" Label="Rate/s" Value="194" Sub="rows/s · peak 312" />
        <MetricCard Icon="cpu" Label="Memory" Value="412 MB" Sub="limit 1.2 GB" />
    </div>

    <div class="grid-1-5">
        <div class="col" style="gap:12px">
            <Card Title="Processing rate" Sub="Rows/s · last 2 min">
                <Action><span class="live-indicator"><span class="dot"></span>live</span></Action>
                <ChildContent>
                <svg viewBox="0 0 600 90" width="100%" height="90" preserveAspectRatio="none">
                    <defs><linearGradient id="spk" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#1E6DC3" stop-opacity="0.18" /><stop offset="100%" stop-color="#1E6DC3" stop-opacity="0" /></linearGradient></defs>
                    <path d="@_areaPath" fill="url(#spk)" />
                    <path d="@_linePath" stroke="#1E6DC3" stroke-width="1.5" fill="none" />
                </svg>
                </ChildContent>
            </Card>

            <Card Title="Timeline" Sub="Job events">
                <Action><button class="btn link">View full logs</button></Action>
                <ChildContent>
                    <Timeline Events="_events" />
                </ChildContent>
            </Card>
        </div>

        <div class="col" style="gap:12px">
            <Card Title="Configuration">
                <div class="kv">
                    <span class="k">Source</span><span class="v mono">sales-db · SQL Server</span>
                    <span class="k">Formats</span><span class="v">CSV, XLSX</span>
                    <span class="k">Buffer</span><span class="v mono">1,000 rows/page</span>
                    <span class="k">Retry policy</span><span class="v mono">5× · exp 2s..30s · jitter</span>
                    <span class="k">On failure</span><span class="v">save partial + alert</span>
                    <span class="k">Worker</span><span class="v mono">worker-04 · default pool</span>
                </div>
            </Card>

            <Card Title="Destinations" Sub="2 pending confirmation">
                <div class="list-row" style="padding:6px 0"><CatTile Sm="true" Kind="info" Icon="cloud-upload" /><div class="col" style="gap:0"><span class="name">SharePoint · /Sales/2026/05</span><span class="sub">awaiting upload</span></div></div>
                <div class="list-row" style="padding:6px 0"><CatTile Sm="true" Kind="info" Icon="brand-aws" /><div class="col" style="gap:0"><span class="name">s3://acme-reports/retail</span><span class="sub">awaiting upload</span></div></div>
            </Card>

            <Card Title="Retries this job" Sub="1 recovered">
                <div class="list-row" style="border-bottom:0"><span class="cat-tile sm warn"><i class="ti ti-refresh" style="font-size:14px"></i></span><div class="col" style="gap:0"><span class="name">Attempt 2 · page 12</span><span class="sub">4s delay · SqlException 1205 (deadlock)</span></div></div>
            </Card>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "7c4a01f3";
    private int _pct = 64;
    private System.Threading.Timer? _timer;

    private readonly PhaseStepper.Phase[] _phases =
    {
        new("Connect", "done"), new("Authenticate", "done"), new("Schema", "done"),
        new("Read+write", "active"), new("Upload", ""),
    };

    private readonly Timeline.EventRow[] _events =
    {
        new("14:32:06", "info", "info-circle", "Started by marina.s", "trigger: manual · job_7c4a01f3"),
        new("14:32:07", "ok", "check", "Connection established", "sales-db · 142ms"),
        new("14:32:08", "ok", "check", "Schema validated", "12 columns · checksum OK"),
        new("14:33:11", "warn", "alert-triangle", "Retry after lock-timeout", "attempt 2 of 5 · backoff exp 4s"),
        new("14:33:15", "ok", "check", "Retry recovered", "resumed at page 12"),
        new("14:34:02", "ok", "check", "Page 26 written", "26,000 / 42,000 rows · 64% complete"),
    };

    // static sparkline geometry
    private string _linePath = "";
    private string _areaPath = "";

    protected override void OnInitialized()
    {
        var data = new[] { 120,140,130,150,200,240,220,260,280,312,300,290,280,200,180,220,240,230,210,194 };
        double W = 600, H = 90, P = 6; int max = data.Max(), min = data.Min();
        double stepX = (W - P * 2) / (data.Length - 1);
        var pts = data.Select((d, i) => (x: P + i * stepX, y: H - P - ((d - min) / (double)(max - min)) * (H - P * 2 - 6))).ToArray();
        _linePath = string.Join(" ", pts.Select((p, i) => $"{(i == 0 ? "M" : "L")}{p.x:0.#},{p.y:0.#}"));
        _areaPath = $"{_linePath} L{pts[^1].x:0.#},{H - P} L{P},{H - P} Z";

        _timer = new System.Threading.Timer(_ =>
        {
            _pct = _pct >= 70 ? 60 : _pct + 1;
            InvokeAsync(StateHasChanged);
        }, null, 1100, 1100);
    }

    public void Dispose() => _timer?.Dispose();
}
