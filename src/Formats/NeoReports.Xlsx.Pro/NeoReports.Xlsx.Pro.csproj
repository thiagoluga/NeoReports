<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Description>NeoReports Pro — streaming multi-sheet XLSX workbook writer (one worksheet per view).</Description>
    <PackageTags>reports;reporting;xlsx;excel;workbook;multi-sheet</PackageTags>

    <!-- Commercial package. NOT MIT: licensed under PolyForm Small Business 1.0.0 (free for
         organizations under USD 1M annual revenue; a commercial license is required above that) —
         which is why the repo-wide MIT metadata is overridden below.
         PUBLISHED to nuget.org (D70, reversing D30's distribution-only gating; wired up in D83).
         Enforcement is no longer "you cannot get the package" but the runtime license check in
         NeoReports.Licensing, so the package itself is public while its features are not free. -->
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- PackageLicenseFile requires the license to travel inside the package. -->
    <None Include="LICENSE.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NeoReports.Abstractions\NeoReports.Abstractions.csproj" />
    <ProjectReference Include="..\..\NeoReports.Core\NeoReports.Core.csproj" />
    <ProjectReference Include="..\..\NeoReports.Licensing\NeoReports.Licensing.csproj" />
    <ProjectReference Include="..\NeoReports.Formats.Xlsx\NeoReports.Formats.Xlsx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

</Project>
