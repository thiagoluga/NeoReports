<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Description>Parquet file source (local or S3) with constant-memory, row-group-at-a-time streaming for NeoReports.</Description>
    <PackageTags>reports;reporting;source;parquet;file;s3</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NeoReports.Abstractions\NeoReports.Abstractions.csproj" />
    <ProjectReference Include="..\..\NeoReports.Core\NeoReports.Core.csproj" />
    <ProjectReference Include="..\NeoReports.Sources.Files.Common\NeoReports.Sources.Files.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>

</Project>
