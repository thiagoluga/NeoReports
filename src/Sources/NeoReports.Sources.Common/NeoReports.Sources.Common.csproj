<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Description>Shared ADO.NET keyset-pagination engine reused by NeoReports' relational source packages.</Description>
    <PackageTags>reports;reporting;source;ado;sql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NeoReports.Abstractions\NeoReports.Abstractions.csproj" />
    <ProjectReference Include="..\..\NeoReports.Core\NeoReports.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit tests exercise the keyset cursor codec directly, without a Docker-gated
         integration test, since the ADO engine's shared correctness otherwise rides entirely on
         the provider integration suites. -->
    <InternalsVisibleTo Include="NeoReports.Sources.Common.UnitTests" />
  </ItemGroup>

</Project>
