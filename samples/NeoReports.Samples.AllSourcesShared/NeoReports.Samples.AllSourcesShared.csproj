<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Separate from NeoReports.Samples.Shared on purpose: this one drags in four database drivers,
       and every lightweight sample references Samples.Shared. Only the Aspire all-sources demos
       (14 and 15) reference this. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\NeoReports.Abstractions\NeoReports.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\NeoReports.Core\NeoReports.Core.csproj" />
    <ProjectReference Include="..\NeoReports.Samples.Shared\NeoReports.Samples.Shared.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.Postgres\NeoReports.Sources.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.MySql\NeoReports.Sources.MySql.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.Sql\NeoReports.Sources.Sql.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.MongoDb\NeoReports.Sources.MongoDb.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.Sqlite\NeoReports.Sources.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Sources\NeoReports.Sources.Oracle\NeoReports.Sources.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Integrations\NeoReports.AspNetCore\NeoReports.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Jobs\NeoReports.Jobs\NeoReports.Jobs.csproj" />
    <ProjectReference Include="..\..\src\UI\NeoReports.UI\NeoReports.UI.csproj" />
    <ProjectReference Include="..\..\src\Formats\NeoReports.Formats.Csv\NeoReports.Formats.Csv.csproj" />
    <ProjectReference Include="..\..\src\Formats\NeoReports.Formats.Xlsx\NeoReports.Formats.Xlsx.csproj" />
    <ProjectReference Include="..\..\src\Destinations\NeoReports.Destinations.Local\NeoReports.Destinations.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

</Project>
