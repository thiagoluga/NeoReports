# ---------------------------------------------------------------------------
# .NET / NeoReports .gitignore
# ---------------------------------------------------------------------------

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*_i.c
*_p.c

# Test / coverage results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/
BenchmarkDotNet.Artifacts/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
.nuget/

# MSBuild / Roslyn
*.binlog
project.lock.json
project.fragment.lock.json

# Rider/ReSharper
_ReSharper*/
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local environment / secrets
*.env
.env.local
appsettings.*.local.json
secrets.json

# Scratch files used by the local build/test loop (never committed)
_*.log
_*.txt
*.flag
